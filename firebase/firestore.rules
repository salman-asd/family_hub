rules_version = '2';

// ============================================================================
// Family Hub — Firestore Security Rules v2.1 (Step 10 + hardening H4-H7)
//
// One permission matrix, twice: `lib/core/permissions/permission_policy.dart`
// for the app, and this file for the backend.  CLAUDE.md hard rule 12: every
// permission is enforced here as well as in the UI.
//
// Collections covered today (roadmap Steps 6-9, hardening H4-H7):
//   users/{uid}
//   inviteCodes/{code}
//   families/{f}
//   families/{f}/members/{m}
//   families/{f}/invitations/{i}
//   families/{f}/bazarCategories/{c}   (P2-05)
//   families/{f}/bazarItems/{i}        (P2-05)
//   families/{f}/budgets/{yyyy-MM}     (P2-17)
//   families/{f}/settings/{s}   (general, modules, rotationPolicy,
//                                notificationDefaults, permissions,
//                                relationships)
//   families/{f}/activity/{a}
//   families/{f}/auditLogs/{a}
//
// Everything else is denied (default deny at the bottom).  From Step 10 onward
// CLAUDE.md requires every step that adds a collection to extend this file AND
// `firebase/rules_test/` in the same commit.
//
// H5 additions:
//   * field validation helpers (`str`, `optStr`, `memberProfileOk`) on every
//     member write and on `users/{uid}.fullName`/`nickname`;
//   * closed key sets (`keys().hasOnly(...)`) for members, families, invites,
//     settings and logs — the lists live in ONE place here as `*Keys()`
//     functions and are mirrored by `test/contract/rules_key_sets_test.dart`;
//   * log integrity: an activity/audit `create` must be written by its own
//     actor, with a known `type`/`refType`, bounded `refId`, a small `params`
//     map and a SERVER `recordedAt` (the client `createdAt` is untouched);
//     P2-03 extended the two closed lists with the Phase 2 bazar vocabulary
//     (roadmap section 3.9), mirrored by `audit_event_type.dart` and
//     `audit_ref_type.dart`;
//   * an invite may only be burned in the SAME batch that creates the caller's
//     pending member document;
//   * `verified()`: a verified email is required for every mutating action
//     except the owner's own `users/{uid}` profile/preferences.
//
// H7 additions:
//   * `families/{f}/settings/permissions` (booleans: moderatorManagesFinance,
//     membersViewFamilyReports, membersViewAllContributions, membersCanInvite,
//     choreVerificationEnabled) rides the generic `settings/{s}` rule: every
//     active member reads it, only an admin writes it.  `membersCanInvite`
//     lets a plain member create invitations and revoke their own
//     (`canInvite`, `membersMayInvite`);
//   * the Dart matrix (`PermissionPolicy`) reads the same document, and
//     docs/permission_matrix.md is generated from it.
//
// H6 additions (decision D4: at most three admins):
//   * `families/{f}.adminIds` lists 1..3 uids of ACTIVE admins.  A family
//     create writes the creator alone; a family update re-checks every listed
//     uid against its member document (`adminIdsOk`), so the list can never
//     name a non-admin, an inactive member or an empty set;
//   * a member update that changes the active-admin set (demote, disable,
//     remove, leave or promote) MUST rewrite the family document in the SAME
//     batch (`adminIdsRewritten`), so the check above always runs and the last
//     admin cannot leave, be demoted or be disabled — the invariant the rules
//     could not express before.  `leavesNoActiveAdmin` in permission_access.dart
//     stays as the client-side guard with a localized message; the rules are
//     the real enforcement.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Primitives ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // H5: an address-verified account is required for every mutating action
    // outside the owner's own profile.  The claim is refreshed by
    // FirebaseAuthRepository.reloadUser() (`getIdToken(true)`).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function writesAsSelf() {
      return request.resource.data.get('updatedBy', '') == request.auth.uid;
    }
    function createsAsSelf() {
      return request.resource.data.get('createdBy', '') == request.auth.uid;
    }
    function inList(value, allowed) {
      return value in allowed;
    }
    // H5 field validation.
    function str(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }
    function optStr(d, k, hi) {
      return !(k in d.keys()) || d[k] == null || str(d[k], 0, hi);
    }
    // H10: relationships are an editable list (`settings/relationships`), so the
    // stored value is an ID checked by pattern, not a closed enum.  Mirrors
    // `RelationshipId.isValid`.
    function relationshipOk(data) {
      return data.get('relationship', 'other') is string
        && data.get('relationship', 'other').matches('^[a-z][a-zA-Z0-9_]{1,30}$');
    }
    // Enums are validated against the closed sets of the domain models, so a
    // forged document fails here rather than at the next read.
    function genderOk(data) {
      return !('gender' in data.keys())
        || data.gender == null
        || data.gender in ['male', 'female', 'other'];
    }
    // users/{uid}.preferences {themeId, themeMode, language, banglaDigits}.
    function preferencesOk(data) {
      return !('preferences' in data.keys())
        || (
          data.preferences is map
          && data.preferences.get('themeId', '') is string
          && data.preferences.get('themeMode', 'system') in ['system', 'light', 'dark']
          && data.preferences.get('language', 'bn') in ['bn', 'en']
          && data.preferences.get('banglaDigits', false) is bool
        );
    }
    // Money is integer paisa (CLAUDE.md rule 1).  Applied to the money
    // collections from Step 13 (`expenses`) onwards; no money field exists yet,
    // so this helper is the guard those steps must use rather than a new one.
    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }
    function isNonNegativeIntOrMissing(data, key) {
      return !(key in data.keys()) || isNonNegativeInt(data[key]);
    }
    // ── Phase 2 scaffold (H12) ─────────────────────────────────────────────
    // Reusable guards for the collections Steps 12+ add.  Nothing uses them
    // yet; a new collection composes these instead of inventing its own.
    // See docs/new_collection_checklist.md.
    function canReadFamilyData(f) {
      return isActiveMember(f);
    }
    // A record the caller creates for themselves in their own family.
    function canWriteOwnRecord(f) {
      return verified() && isActiveMember(f) && createsAsSelf();
    }
    // Integer paisa that is present and non-negative.
    function moneyOk(data, key) {
      return key in data.keys() && isNonNegativeInt(data[key]);
    }
    // `yyyy-MM-dd` / `yyyy-MM` keys in the family time zone.
    function dateKeyOk(s) {
      return s is string && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function monthKeyOk(s) {
      return s is string && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    // CLAUDE.md rule 5: an update may only set the soft-delete and update stamps.
    function softDeleteOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deletedAt', 'deletedBy', 'updatedAt', 'updatedBy']);
    }
    // H5: the denormalised member profile.  Applied to every member create and
    // to the admin/self updates (the field set is the same).
    function memberProfileOk(d) {
      return str(d.get('fullName', ''), 1, 80)
        && optStr(d, 'nickname', 40)
        && relationshipOk(d)
        && optStr(d, 'spouseId', 40)
        && optStr(d, 'avatarKey', 40)
        && optStr(d, 'inviteCode', 16);
    }

    // ── Closed key sets (H5) ───────────────────────────────────────────────
    // The exact fields each mapper writes.  A document with an unknown field is
    // denied.  Mirrored in test/contract/rules_key_sets_test.dart so a mapper
    // change that is not reflected here fails the build.
    function memberKeys() {
      return ['uid', 'role', 'status', 'fullName', 'nickname', 'relationship',
              'spouseId', 'avatarKey', 'inviteCode', 'removedAt', 'leftAt',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function familyKeys() {
      return ['name', 'adminIds', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy', 'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    // inviteCodes/{code} and families/{f}/invitations/{i} share one shape.
    function invitationKeys() {
      return ['code', 'familyId', 'role', 'status', 'expiresAt', 'usedBy',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion'];
    }
    // The union of the four settings documents created with the family.
    function settingsKeys() {
      return ['timezone', 'currency', 'flags', 'absencePolicy', 'enabled',
              'moderatorManagesFinance', 'membersViewFamilyReports',
              'membersViewAllContributions', 'membersCanInvite',
              'choreVerificationEnabled', 'items',
              // P3-03: one new family switch (road map 3.3).
              'membersCanCompleteForOthers',
              // P2-07: settings/bazar.
              'weekStartDay', 'defaultMonthlyContributionPaisa',
              'contributionDueDay', 'alertThresholds', 'fundStartMonth',
              // P3-06: settings/chores (road map 3.2).
              'defaultCalendarView', 'defaultScope', 'generationHorizonDays',
              'showProjected', 'projectedMonthsAhead', 'overdueGraceMinutes',
              'swapsEnabled', 'swapExpiryBufferMinutes',
              'absenceNeedsApproval', 'workloadVisibleToMembers', 'houseRules',
              'dueTimePresets', 'groups', 'absenceReasons',
              // P3-06: settings/choreGeneration (the generation marker).
              'throughEpochDay',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    // P3-06: a catalog row is a map whose `id` is a machine id.  Rules cannot
    // loop, so only the SIZE of a list and the shape of its FIRST and LAST row
    // are checked here; the app tolerates a malformed row in the middle and
    // ChoreSettingsValidator is the authority for every row.
    function catalogIdOk(v) {
      return v is string && v.size() >= 1 && v.size() <= 24
        && v.matches('^[a-z0-9_]+$');
    }
    function catalogRowOk(item, labelKey) {
      return item is map
        && catalogIdOk(item.get('id', ''))
        && item.get(labelKey, '') is string
        && item.get('builtIn', false) is bool
        && item.get('active', true) is bool;
    }
    function catalogOk(d, k, maxItems, labelKey) {
      return !(k in d.keys()) || (
        d[k] is list
        && d[k].size() <= maxItems
        && (d[k].size() == 0
            || (catalogRowOk(d[k][0], labelKey)
                && catalogRowOk(d[k][d[k].size() - 1], labelKey)))
      );
    }
    // P3-06: settings/chores.  Ranges of road map 3.2; the same limits are in
    // ChoreSettingsLimits / ChoreSettingsValidator (mirrored by a Dart test).
    function choreSettingsOk(d) {
      return settingsOk(d)
        && d.get('weekStartDay', 6) is int
        && d.get('weekStartDay', 6) >= 1 && d.get('weekStartDay', 6) <= 7
        && d.get('defaultCalendarView', 'agenda') in ['agenda', 'month', 'week']
        && d.get('defaultScope', 'mine') in ['mine', 'all']
        && d.get('generationHorizonDays', 30) is int
        && d.get('generationHorizonDays', 30) >= 14
        && d.get('generationHorizonDays', 30) <= 90
        && boolOk(d, 'showProjected')
        && d.get('projectedMonthsAhead', 3) is int
        && d.get('projectedMonthsAhead', 3) >= 0
        && d.get('projectedMonthsAhead', 3) <= 12
        && d.get('overdueGraceMinutes', 0) is int
        && d.get('overdueGraceMinutes', 0) >= 0
        && d.get('overdueGraceMinutes', 0) <= 240
        && boolOk(d, 'swapsEnabled')
        && d.get('swapExpiryBufferMinutes', 120) is int
        && d.get('swapExpiryBufferMinutes', 120) >= 0
        && d.get('swapExpiryBufferMinutes', 120) <= 1440
        && boolOk(d, 'absenceNeedsApproval')
        && boolOk(d, 'workloadVisibleToMembers')
        && optStr(d, 'houseRules', 2000)
        && catalogOk(d, 'groups', 30, 'nameBn')
        && catalogOk(d, 'dueTimePresets', 8, 'labelBn')
        && catalogOk(d, 'absenceReasons', 12, 'labelBn');
    }
    // P3-06: settings/choreGeneration {throughEpochDay}.  Any active member may
    // only ADVANCE the marker, by at most 120 days per write (D-P3-10).  A
    // create is always an advance (there is no previous value).
    function generationOk(d) {
      return d.get('throughEpochDay', 0) is int
        && d.get('throughEpochDay', 0) >= 0;
    }
    function generationAdvances() {
      // `resource` is null on a create, which is always an advance.  (No
      // exists() call: the rules budget is 10 document reads per request.)
      return resource == null
        || (
          request.resource.data.throughEpochDay
            > resource.data.get('throughEpochDay', -1)
          && request.resource.data.throughEpochDay
            <= resource.data.get('throughEpochDay', -1) + 120
        );
    }
    function rotationPolicyOk(d) {
      return settingsOk(d)
        && d.get('absencePolicy', 'ask_cover') in ['ask_cover', 'auto_cover', 'skip'];
    }
    // P3-08: choreTemplates/{id}.  The exact fields ChoreTemplateMappers.toMap
    // writes.  List SIZES are checked here; the per-row shape of `slots`,
    // `subtasks` and the rotation is checked for the first and last row only
    // (rules cannot loop) - TemplateValidator is the authority for every row.
    function templateKeys() {
      return ['nameBn', 'nameEn', 'groupId', 'recurrence', 'slots', 'assignee',
              'instructions', 'subtasks', 'estimatedMinutes', 'difficulty',
              'verification', 'reminders', 'startDate', 'endDate', 'active',
              'archivedAt', 'colorIndex', 'iconKey', 'sortOrder', 'revision',
              'builtIn', 'seedKey',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function slotOk(s) {
      return s is map
        && s.get('key', '') is string
        && s.get('key', '').matches('^[a-z0-9]{1,12}$')
        && optStr(s, 'labelBn', 30)
        && optStr(s, 'labelEn', 30)
        && (!('dueMinutes' in s.keys())
            || s.dueMinutes == null
            || (s.dueMinutes is int && s.dueMinutes >= 0 && s.dueMinutes <= 1439));
    }
    function subtaskOk(s) {
      return s is map
        && s.get('id', '') is string
        && s.get('id', '').matches('^[a-z0-9_]{1,16}$')
        && str(s.get('title', ''), 1, 120)
        && s.get('required', false) is bool
        && optStr(s, 'hint', 200);
    }
    function templateOk(d) {
      return d.keys().hasOnly(templateKeys())
        && str(d.get('nameBn', ''), 1, 80)
        && optStr(d, 'nameEn', 80)
        && optStr(d, 'groupId', 24)
        && d.get('recurrence', {}) is map
        && d.recurrence.get('kind', '') in
             ['once', 'daily', 'every_n_days', 'weekdays', 'every_n_weeks',
              'days_of_month', 'nth_weekday', 'last_day']
        && d.get('slots', []) is list
        && d.slots.size() >= 1 && d.slots.size() <= 6
        && slotOk(d.slots[0])
        && slotOk(d.slots[d.slots.size() - 1])
        && d.get('assignee', {}) is map
        && d.assignee.get('strategy', '') in ['rotation', 'fixed', 'manual']
        && str(d.get('instructions', ''), 0, 4000)
        && d.get('subtasks', []) is list
        && d.subtasks.size() <= 30
        && (d.subtasks.size() == 0
            || (subtaskOk(d.subtasks[0])
                && subtaskOk(d.subtasks[d.subtasks.size() - 1])))
        && (!('estimatedMinutes' in d.keys())
            || d.estimatedMinutes == null
            || (d.estimatedMinutes is int
                && d.estimatedMinutes >= 1 && d.estimatedMinutes <= 600))
        && d.get('difficulty', 'normal') in ['easy', 'normal', 'hard']
        && d.get('verification', 'off') in ['off', 'required']
        && d.get('reminders', {}) is map
        && d.get('startDate', '') is string
        && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('endDate' in d.keys())
            || d.endDate == null
            || (d.endDate is string
                && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.get('active', true) is bool
        && (!('archivedAt' in d.keys()) || d.archivedAt == null
            || d.archivedAt is timestamp)
        && (!('colorIndex' in d.keys()) || d.colorIndex == null
            || (d.colorIndex is int
                && d.colorIndex >= 0 && d.colorIndex <= 11))
        && optStr(d, 'iconKey', 24)
        && d.get('sortOrder', 0) is int
        && d.get('revision', 0) is int && d.revision >= 1
        && d.get('builtIn', false) is bool
        && optStr(d, 'seedKey', 64);
    }
    // P3-10: dutyGroups/{id}.  The exact fields DutyGroupMappers.toMap writes.
    // Rules cannot loop, so only the first and last rotation version are checked
    // here; RotationValidator is the authority for every version in between.
    function dutyGroupKeys() {
      return ['nameBn', 'nameEn', 'colorIndex', 'rotation', 'active',
              'sortOrder', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function rotationVersionOk(v) {
      return v is map
        && v.get('from', '') is string
        && v.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && v.get('members', []) is list
        && v.members.size() >= 2 && v.members.size() <= 12
        && v.members[0] is string && v.members[0].size() > 0
        && v.members[v.members.size() - 1] is string
        && v.members[v.members.size() - 1].size() > 0
        && v.get('anchorDate', '') is string
        && v.anchorDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && v.get('anchorIndex', -1) is int
        && v.anchorIndex >= 0 && v.anchorIndex < v.members.size()
        && v.get('cycleUnit', '') in ['day', 'week', 'month', 'occurrence']
        && v.get('weekStartDay', 0) is int
        && v.weekStartDay >= 1 && v.weekStartDay <= 7;
    }
    function rotationOk(r) {
      return r is map
        && r.keys().hasOnly(['versions'])
        && r.get('versions', []) is list
        && r.versions.size() >= 1 && r.versions.size() <= 20
        && rotationVersionOk(r.versions[0])
        && rotationVersionOk(r.versions[r.versions.size() - 1]);
    }
    function dutyGroupOk(d) {
      return d.keys().hasOnly(dutyGroupKeys())
        && str(d.get('nameBn', ''), 1, 80)
        && optStr(d, 'nameEn', 80)
        && (!('colorIndex' in d.keys()) || d.colorIndex == null
            || (d.colorIndex is int
                && d.colorIndex >= 0 && d.colorIndex <= 11))
        && rotationOk(d.get('rotation', {}))
        && d.get('active', true) is bool
        && d.get('sortOrder', 0) is int;
    }
    // ── P3-13: choreOccurrences/{id} and its events/{id} ─────────────────────
    // The exact fields OccurrenceMappers.toMap writes.  Subtask ticks live in
    // the MAP `subtaskDone` so two phones can tick different boxes without
    // overwriting each other (D-P3-9); the map is bounded by its size.
    function occurrenceKeys() {
      return ['templateId', 'templateRev', 'slotKey', 'dateKey', 'monthKey',
              'dueAt', 'dueMinutes', 'nameBn', 'nameEn', 'groupId',
              'instructions', 'subtasks', 'requiredCount', 'difficulty',
              'estimatedMinutes', 'verification', 'status',
              'plannedAssigneeId', 'assigneeId',
              'coverForId', 'assignmentSource', 'needsCover', 'subtaskDone',
              'completedAt', 'completedBy', 'verifiedAt', 'verifiedBy',
              'reopenCount', 'exception', 'skipReason', 'needsAttention',
              'lastCommentAt', 'lastEventId', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy', 'schemaVersion', 'deletedAt',
              'deletedBy'];
    }
    // The deterministic id (CLAUDE.md rule 4, ADR 0009): README pattern only.
    function occurrenceIdOk(id) {
      return id is string
        && id.matches('^[A-Za-z0-9_]+_[0-9]{8}(_[a-z0-9]{1,12})?$');
    }
    // M-03: the id IS `templateId_yyyyMMdd[_slotKey]` (the main slot has no
    // suffix, ADR 0009).  Rules have no regex capture groups (B-11), so the
    // id is REBUILT from the body and compared for equality: templateId,
    // dateKey and slotKey can never disagree with the id they live under.
    function occurrenceIdMatchesDate(id, d) {
      return id == d.templateId + '_'
        + d.dateKey.replace('-', '').replace('-', '')
        + (d.get('slotKey', null) == null ? '' : '_' + d.slotKey);
    }
    function nullableTimestamp(d, k) {
      return !(k in d.keys()) || d[k] == null || d[k] is timestamp;
    }
    function nullableId(d, k) {
      return !(k in d.keys()) || d[k] == null || str(d[k], 1, 64);
    }
    function exceptionOk(e) {
      return e is map
        && e.keys().hasOnly(['note', 'by', 'at'])
        && str(e.get('note', ''), 3, 300)
        && str(e.get('by', ''), 1, 64)
        && e.get('at', null) is timestamp;
    }
    // The shape of the whole document, whoever writes it.  Snapshot equality
    // with the previous version is checked by the update rules below, because
    // only they need it.
    function occurrenceOk(id, d) {
      return d.keys().hasOnly(occurrenceKeys())
        && occurrenceIdOk(id)
        && str(d.get('templateId', ''), 1, 64)
        && d.get('dateKey', '') is string
        && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && occurrenceIdMatchesDate(id, d)
        && monthKeyOk(d.get('monthKey', ''))
        && d.monthKey == d.dateKey.substring(0, 7)
        && d.get('dueAt', null) is timestamp
        && d.get('templateRev', 0) is int && d.templateRev >= 1
        && optStr(d, 'slotKey', 12)
        && (!('dueMinutes' in d.keys())
            || d.dueMinutes == null
            || (d.dueMinutes is int && d.dueMinutes >= 0 && d.dueMinutes <= 1439))
        && str(d.get('nameBn', ''), 1, 80)
        && optStr(d, 'nameEn', 80)
        && optStr(d, 'groupId', 24)
        && str(d.get('instructions', ''), 0, 4000)
        && d.get('subtasks', []) is list
        && d.subtasks.size() <= 30
        && (d.subtasks.size() == 0
            || (subtaskOk(d.subtasks[0])
                && subtaskOk(d.subtasks[d.subtasks.size() - 1])))
        && d.get('requiredCount', 0) is int
        && d.get('requiredCount', 0) >= 0
        && d.get('requiredCount', 0) <= d.subtasks.size()
        && d.get('difficulty', 'normal') in ['easy', 'normal', 'hard']
        && (!('estimatedMinutes' in d.keys())
            || d.estimatedMinutes == null
            || (d.estimatedMinutes is int
                && d.estimatedMinutes >= 1 && d.estimatedMinutes <= 600))
        && d.get('verification', 'off') in ['off', 'required']
        && d.get('status', '') in ['scheduled', 'in_progress', 'completed',
                                   'verified', 'skipped']
        && nullableId(d, 'plannedAssigneeId')
        && nullableId(d, 'assigneeId')
        && nullableId(d, 'coverForId')
        && d.get('assignmentSource', '') in ['rotation', 'fixed', 'manual',
                                             'cover', 'swap', 'reassign']
        && d.get('needsCover', false) is bool
        && d.get('subtaskDone', null) is map
        && d.get('subtaskDone', {}).size() <= 30
        && nullableTimestamp(d, 'completedAt')
        && nullableId(d, 'completedBy')
        && nullableTimestamp(d, 'verifiedAt')
        && nullableId(d, 'verifiedBy')
        && d.get('reopenCount', 0) is int && d.reopenCount >= 0
        && d.reopenCount <= 100
        && (!('exception' in d.keys())
            || d.exception == null
            || exceptionOk(d.exception))
        && (!('skipReason' in d.keys())
            || d.skipReason == null
            || d.skipReason in ['absence', 'manager'])
        && d.get('needsAttention', false) is bool
        && nullableTimestamp(d, 'lastCommentAt')
        && (!('lastEventId' in d.keys()) || d.lastEventId == null
            || (d.lastEventId is string
                && d.lastEventId.matches('^[A-Za-z0-9_-]{1,64}$')));
    }
    // What a CREATE writes: straight from the generator, no history at all.
    // The mapper writes every history field as an explicit null, so "no history"
    // is `== null` (an absent key reads as null through `get`), never a
    // key-absence test.
    function occurrenceFresh(d) {
      return d.get('status', '') == 'scheduled'
        && d.get('subtaskDone', {}).size() == 0
        && d.get('completedAt', null) == null
        && d.get('completedBy', null) == null
        && d.get('verifiedAt', null) == null
        && d.get('verifiedBy', null) == null
        && d.get('reopenCount', 0) == 0
        && d.get('exception', null) == null
        && d.get('skipReason', null) == null
        && d.get('needsAttention', false) == false
        && d.get('lastCommentAt', null) == null
        && d.get('deletedAt', null) == null
        && d.get('deletedBy', null) == null;
    }
    function occurrencePath(f, o) {
      return /databases/$(database)/documents/families/$(f)/choreOccurrences/$(o);
    }
    function occurrenceEventPath(f, o, e) {
      return /databases/$(database)/documents/families/$(f)/choreOccurrences/$(o)/events/$(e);
    }
    // The snapshot fields a template edit may refresh (P3-12 replan).
    function occurrenceSnapshotUnchanged(after, before) {
      return after.get('templateId', '') == before.get('templateId', '')
        && after.get('slotKey', null) == before.get('slotKey', null)
        && after.get('dateKey', '') == before.get('dateKey', '')
        && after.get('monthKey', '') == before.get('monthKey', '')
        && after.get('templateRev', 0) == before.get('templateRev', 0)
        && after.get('nameBn', '') == before.get('nameBn', '')
        && after.get('nameEn', null) == before.get('nameEn', null)
        && after.get('groupId', null) == before.get('groupId', null)
        && after.get('instructions', '') == before.get('instructions', '')
        && after.get('subtasks', []) == before.get('subtasks', [])
        && after.get('requiredCount', 0) == before.get('requiredCount', 0)
        && after.get('difficulty', 'normal') == before.get('difficulty', 'normal')
        && after.get('estimatedMinutes', null)
             == before.get('estimatedMinutes', null)
        && after.get('verification', 'off') == before.get('verification', 'off')
        && after.get('dueAt', null) == before.get('dueAt', null)
        && after.get('dueMinutes', null) == before.get('dueMinutes', null)
        && after.get('createdAt', null) == before.get('createdAt', null)
        && after.get('createdBy', '') == before.get('createdBy', '');
    }
    // D-P3-14: a plain member only acts on somebody else's chore when the
    // family switch allows it.  Absent document or key = false.
    function membersMayCompleteForOthers(f) {
      return isActiveMember(f)
        && exists(permissionsPath(f))
        && get(permissionsPath(f)).data
             .get('membersCanCompleteForOthers', false) == true;
    }
    function mayTick(f, before) {
      return isActiveMember(f)
        && (isManager(f)
            || before.get('assigneeId', null) == request.auth.uid
            || membersMayCompleteForOthers(f));
    }
    // M-01: a finished chore has every required step ticked (the count is a
    // snapshot taken at create / replan) or a manager recorded an exception.
    function completionValid(d) {
      return d.get('subtaskDone', {}).size() >= d.get('requiredCount', 0)
        || d.get('exception', null) is map;
    }
    // B-05: every lifecycle event has its OWN unique id, generated once per
    // user intent, and the occurrence names it in `lastEventId`.  The event
    // must be CREATED IN THIS BATCH (absent before, present after), written by
    // the caller, of the expected type and carry a reason where one is needed.
    // A repeat of the same transition (complete, untick, complete, untick; skip,
    // unskip, skip; A->B->A) therefore never collides.
    function occurrenceEventNew(f, o, type, minReason) {
      let e = request.resource.data.get('lastEventId', null);
      return e is string
        && e.matches('^[A-Za-z0-9_-]{1,64}$')
        && !exists(occurrenceEventPath(f, o, e))
        && existsAfter(occurrenceEventPath(f, o, e))
        && getAfter(occurrenceEventPath(f, o, e)).data.get('type', '') == type
        && getAfter(occurrenceEventPath(f, o, e)).data.get('actorId', '')
             == request.auth.uid
        && eventReasonOk(
             getAfter(occurrenceEventPath(f, o, e)).data.get('reason', null),
             minReason);
    }
    // The mapper always writes `reason`, as null when there is none, so a
    // null counts as the empty string (a 0-length minimum accepts it).
    function eventReasonOk(reason, minReason) {
      return reason == null ? minReason == 0 : str(reason, minReason, 300);
    }
    // The family's calendar day (Asia/Dhaka, UTC+6, no DST).  B-11: only
    // documented timestamp methods (`year()`, `month()`, `day()`) and
    // `timestamp + duration`; the old version used a non-existent
    // `timestamp.date(timestamp.value(..))`, `.year` and `.toString()`.
    // Still fixed to UTC+6 (M-07, ADR 0014, CLAUDE.md rule 46): the family
    // timezone setting is not read.
    function todayKey(f) {
      let local = request.time + duration.value(6, 'h');
      return string(local.year()) + '-'
        + (local.month() < 10 ? '0' : '') + string(local.month()) + '-'
        + (local.day() < 10 ? '0' : '') + string(local.day());
    }
    // Exactly what `OccurrenceEventMappers.toMap` writes (the timeline orders
    // by `createdAt`; there is no separate `at`).  The null soft-delete pair is
    // part of the base metadata every mapper writes.
    function occurrenceEventOk(d) {
      return d.keys().hasOnly(['type', 'actorId', 'fromAssigneeId',
                               'toAssigneeId', 'reason', 'prevCompletedAt',
                               'redoSubtaskIds', 'requestId', 'createdAt',
                               'createdBy', 'updatedAt', 'updatedBy',
                               'schemaVersion', 'deletedAt', 'deletedBy'])
        && d.get('type', '') in ['covered', 'swapped', 'reassigned',
                                 'completed', 'uncompleted', 'verified',
                                 'reopened', 'exception', 'skipped',
                                 'unskipped']
        && d.get('actorId', '') is string
        && optStr(d, 'reason', 300)
        && nullableId(d, 'fromAssigneeId')
        && nullableId(d, 'toAssigneeId')
        && nullableId(d, 'requestId')
        && nullableTimestamp(d, 'prevCompletedAt')
        && (!('redoSubtaskIds' in d.keys())
            || (d.redoSubtaskIds is list && d.redoSubtaskIds.size() <= 30))
        && d.get('deletedAt', null) == null
        && d.get('deletedBy', null) == null;
    }
    // Every occurrence update keeps the metadata and the soft-delete pair of a
    // live document; only the transitions listed in the match block change it.
    function occurrenceLive() {
      return resource.data.get('deletedAt', null) == null;
    }
    function occurrenceChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Phase 2 catalog (P2-05): the exact fields `CatalogMappers` writes.
    function categoryKeys() {
      return ['nameBn', 'nameEn', 'colorIndex', 'emoji', 'imageData',
              'sortOrder', 'active', 'builtIn', 'seedKey', 'createdAt',
              'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion',
              'deletedAt', 'deletedBy'];
    }
    function itemKeys() {
      return ['nameBn', 'nameEn', 'categoryId', 'defaultUnit', 'aliases',
              'emoji', 'imageData', 'useCount', 'lastPricePaisa',
              'lastUnitPricePaisa', 'lastUsedAt', 'active', 'builtIn',
              'seedKey', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    // Phase 2 budgets (P2-17): the exact fields `BudgetMappers.toMap` writes.
    function budgetKeys() {
      return ['monthKey', 'totalEstimatePaisa', 'categoryEstimates', 'lines',
              'alertThresholds', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy', 'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    // Phase 2 contributions (P2-19): the exact fields `ContributionMappers`
    // writes.  Optional values (fundTxId, decidedBy, ...) are ABSENT until set.
    function contributionKeys() {
      return ['memberId', 'monthKey', 'dateKey', 'amountPaisa', 'method',
              'note', 'status', 'requestedBy', 'fundTxId', 'decidedBy',
              'decidedAt', 'rejectReason', 'pendingChange', 'voidedAt',
              'voidedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function contributionPlanKeys() {
      return ['monthKey', 'memberId', 'expectedPaisa', 'createdAt',
              'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion',
              'deletedAt', 'deletedBy'];
    }
    // Phase 2 expenses, trips, ledger and advances (P2-10).  These mirror
    // ExpenseMappers / FundMappers / AdvanceMappers and MonthClosingMappers.
    function expenseKeys() {
      return ['dateKey', 'monthKey', 'occurredAt', 'itemId', 'itemName',
              'categoryId', 'qtyMilli', 'unit', 'unitPricePaisa', 'totalPaisa',
              'fundingSource', 'paidByMemberId', 'reimbursable', 'purchaserId',
              'tripId', 'shop', 'note', 'source', 'importBatchId',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function tripKeys() {
      return ['dateKey', 'monthKey', 'shop', 'fundingSource',
              'paidByMemberId', 'reimbursable', 'lineCount', 'totalPaisa',
              'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function revisionKeys() {
      return ['before', 'changedFields', 'reason', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy', 'schemaVersion', 'deletedAt',
              'deletedBy'];
    }
    function fundTxKeys() {
      return ['type', 'amountPaisa', 'dateKey', 'monthKey', 'refType',
              'refId', 'note', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy', 'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function advanceKeys() {
      return ['expenseId', 'memberId', 'amountPaisa', 'settledPaisa',
              'status', 'dateKey', 'monthKey', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy', 'schemaVersion', 'deletedAt',
              'deletedBy'];
    }
    function settlementKeys() {
      return ['advanceId', 'memberId', 'amountPaisa', 'dateKey', 'monthKey',
              'method', 'note', 'fundTxId', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy', 'schemaVersion', 'deletedAt',
              'deletedBy'];
    }
    function closingKeys() {
      return ['monthKey', 'status', 'closedAt', 'closedBy',
              'closingBalancePaisa', 'reopenedAt', 'reopenedBy', 'reopenNote',
              'reopenCount', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy', 'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function eventKeys() {
      return ['type', 'actorId', 'summary', 'refType', 'refId', 'params',
              'recordedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion'];
    }
    // H7: the `settings/permissions` switches are booleans or absent.
    function boolOk(d, k) {
      return !(k in d.keys()) || d[k] is bool;
    }
    function settingsOk(d) {
      return d.keys().hasOnly(settingsKeys())
        && boolOk(d, 'moderatorManagesFinance')
        && boolOk(d, 'membersViewFamilyReports')
        && boolOk(d, 'membersViewAllContributions')
        && boolOk(d, 'membersCanInvite')
        && boolOk(d, 'choreVerificationEnabled')
        && boolOk(d, 'membersCanCompleteForOthers')
        && optStr(d, 'timezone', 64)
        && optStr(d, 'currency', 8)
        && (!('flags' in d.keys())
            || (d.flags is map && d.flags.size() <= 8))
        && optStr(d, 'absencePolicy', 32)
        // H10: `settings/relationships.items` is a bounded list (the per-item
        // shape cannot be iterated in rules; the app tolerates ill-formed items).
        && (!('items' in d.keys())
            || (d.items is list && d.items.size() <= 40))
        // P2-07: settings/bazar.  The fields are optional so the same shape
        // function can validate every settings document.
        && isNonNegativeIntOrMissing(d, 'defaultMonthlyContributionPaisa')
        && (!('weekStartDay' in d.keys())
            || (d.weekStartDay is int
                && d.weekStartDay >= 1 && d.weekStartDay <= 7))
        && (!('contributionDueDay' in d.keys())
            || (d.contributionDueDay is int
                && d.contributionDueDay >= 1 && d.contributionDueDay <= 28))
        && (!('alertThresholds' in d.keys())
            || (d.alertThresholds is list && d.alertThresholds.size() <= 4))
        && (!('fundStartMonth' in d.keys())
            || d.fundStartMonth == null || monthKeyOk(d.fundStartMonth));
    }
    // The catalog document shapes (P2-05).  Limits mirror
    // `catalog_validation.dart`: names 60, aliases 10, emoji 8, image 24000.
    function categoryOk(d) {
      return d.keys().hasOnly(categoryKeys())
        && str(d.get('nameBn', ''), 1, 60)
        && optStr(d, 'nameEn', 60)
        && d.get('colorIndex', -1) is int
        && d.get('colorIndex', -1) >= 0
        && d.get('colorIndex', -1) <= 11
        && optStr(d, 'emoji', 8)
        && optStr(d, 'imageData', 24000)
        && d.get('sortOrder', -1) is int
        && d.get('active', false) is bool
        && d.get('builtIn', false) is bool
        && optStr(d, 'seedKey', 40);
    }
    function itemOk(d) {
      return d.keys().hasOnly(itemKeys())
        && str(d.get('nameBn', ''), 1, 60)
        && optStr(d, 'nameEn', 60)
        && str(d.get('categoryId', ''), 1, 64)
        && d.get('defaultUnit', '') in ['kg', 'g', 'litre', 'piece',
                                        'dozen', 'packet', 'cylinder']
        && d.get('aliases', []) is list
        && d.get('aliases', []).size() <= 10
        && optStr(d, 'emoji', 8)
        && optStr(d, 'imageData', 24000)
        && d.get('useCount', -1) is int
        && d.get('useCount', -1) >= 0
        // Money is integer paisa; absent means "no last price yet".
        && isNonNegativeIntOrMissing(d, 'lastPricePaisa')
        && isNonNegativeIntOrMissing(d, 'lastUnitPricePaisa')
        && (!('lastUsedAt' in d.keys())
            || d.lastUsedAt == null
            || d.lastUsedAt is timestamp)
        && d.get('active', false) is bool
        && d.get('builtIn', false) is bool
        && optStr(d, 'seedKey', 40);
    }

    // A month's budget (P2-17).  The document id IS the month key.  Rules
    // cannot iterate a map or list, so sizes are bounded here (40 category
    // estimates, 150 lines, 4 thresholds) and the app tolerates a malformed
    // entry on read.  Total is integer paisa.
    function budgetOk(d, id) {
      return d.keys().hasOnly(budgetKeys())
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('monthKey', '') == id
        && moneyOk(d, 'totalEstimatePaisa')
        && d.get('categoryEstimates', null) is map
        && d.get('categoryEstimates', {}).size() <= 40
        && d.get('lines', null) is list
        && d.get('lines', []).size() <= 150
        && d.get('alertThresholds', null) is list
        && d.get('alertThresholds', []).size() <= 4;
    }

    // ── Phase 2 contributions (P2-19, D-P2-18) ─────────────────────────────
    function contributionMethods() {
      return ['cash', 'bkash', 'nagad', 'bank', 'other'];
    }
    function contributionPath(f, c) {
      return /databases/$(database)/documents/families/$(f)/contributions/$(c);
    }
    function fundTxPathOf(f, t) {
      return /databases/$(database)/documents/families/$(f)/fundTransactions/$(t);
    }
    // A member's change request stored on an approved contribution.
    function pendingChangeOk(p) {
      return p is map
        && p.keys().hasOnly(['amountPaisa', 'dateKey', 'method', 'note',
                             'requestedAt'])
        && p.get('amountPaisa', 0) is int
        && p.amountPaisa > 0
        && dateKeyOk(p.get('dateKey', ''))
        && (!('method' in p.keys()) || p.method in contributionMethods())
        && (!('note' in p.keys()) || str(p.note, 0, 300))
        && p.get('requestedAt', null) is timestamp;
    }
    // The shape every contribution document keeps, whoever writes it.
    function contributionOk(d, id) {
      return d.keys().hasOnly(contributionKeys())
        && str(d.get('memberId', ''), 1, 64)
        && monthKeyOk(d.get('monthKey', ''))
        && dateKeyOk(d.get('dateKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && d.get('amountPaisa', 0) is int
        && d.amountPaisa > 0
        && (!('method' in d.keys()) || d.method in contributionMethods())
        && optStr(d, 'note', 300)
        && d.get('status', '') in ['pending', 'approved', 'rejected']
        && str(d.get('requestedBy', ''), 1, 64)
        && optStr(d, 'rejectReason', 200)
        && optStr(d, 'decidedBy', 64)
        && optStr(d, 'voidedBy', 64)
        && optStr(d, 'fundTxId', 64)
        && (!('decidedAt' in d.keys()) || d.decidedAt is timestamp)
        && (!('voidedAt' in d.keys()) || d.voidedAt is timestamp)
        && (!('pendingChange' in d.keys()) || pendingChangeOk(d.pendingChange))
        && (d.status != 'rejected' || d.get('rejectReason', '') != '')
        && (d.status != 'approved'
            || d.get('fundTxId', '') == 'con_' + id);
    }
    // A fresh document carries no decision, void or change request.
    function contributionFresh(d) {
      return !('fundTxId' in d.keys())
        && !('decidedBy' in d.keys())
        && !('decidedAt' in d.keys())
        && !('rejectReason' in d.keys())
        && !('pendingChange' in d.keys())
        && !('voidedAt' in d.keys())
        && !('voidedBy' in d.keys());
    }
    // The ledger row written in the SAME batch as an approval/record: right id,
    // right amount, right date, right reference.
    function contributionLedgerOk(f, c, d) {
      return existsAfter(fundTxPathOf(f, 'con_' + c))
        && getAfter(fundTxPathOf(f, 'con_' + c)).data.get('type', '') == 'contribution'
        && getAfter(fundTxPathOf(f, 'con_' + c)).data.get('refId', '') == c
        && getAfter(fundTxPathOf(f, 'con_' + c)).data.get('amountPaisa', 0)
             == d.amountPaisa
        && getAfter(fundTxPathOf(f, 'con_' + c)).data.get('dateKey', '')
             == d.dateKey;
    }
    function activeMemberDoc(f, uid) {
      return exists(memberPath(f, uid))
        && get(memberPath(f, uid)).data.get('status', 'pending') == 'active'
        && get(memberPath(f, uid)).data.get('removedAt', null) == null;
    }
    // Who the money belongs to AND who entered it: a member's own request.
    function ownsContribution(r) {
      return r.get('memberId', '') == request.auth.uid
        && r.get('requestedBy', '') == request.auth.uid;
    }
    function contributionCreateOk(f, c, d) {
      return contributionOk(d, c)
        && d.requestedBy == request.auth.uid
        && monthOpen(f, d.monthKey)
        && (
          // (a) a member's own REQUEST: pending, no ledger row, nothing decided.
          (isActiveMember(f)
            && d.memberId == request.auth.uid
            && d.status == 'pending'
            && contributionFresh(d))
          // (b) a manager's RECORD: approved at once, with its ledger row.
          || (financeManager(f)
            && d.status == 'approved'
            && d.get('decidedBy', '') == request.auth.uid
            && activeMemberDoc(f, d.memberId)
            && !('rejectReason' in d.keys())
            && !('pendingChange' in d.keys())
            && !('voidedAt' in d.keys())
            && !('voidedBy' in d.keys())
            && contributionLedgerOk(f, c, d))
        );
    }
    // One update, by exactly one of the allowed transitions.  `a` is the set of
    // fields that change; the rules never trust a full-document replace.
    function contributionUpdateOk(f, c) {
      let before = resource.data;
      let after = request.resource.data;
      let a = request.resource.data.diff(resource.data).affectedKeys();
      return contributionOk(after, c)
        && after.get('createdAt', null) == before.get('createdAt', null)
        && after.get('createdBy', '') == before.get('createdBy', '')
        && after.get('memberId', '') == before.get('memberId', '')
        && after.get('requestedBy', '') == before.get('requestedBy', '')
        && monthOpen(f, before.monthKey)
        && monthOpen(f, after.monthKey)
        && (
          // Owner edits a PENDING request (the status cannot move).
          (isActiveMember(f)
            && ownsContribution(before)
            && before.status == 'pending'
            && !('voidedAt' in before.keys())
            && after.status == 'pending'
            && a.hasOnly(['amountPaisa', 'dateKey', 'monthKey', 'method',
                          'note', 'updatedAt', 'updatedBy']))
          // Owner withdraws a PENDING request (soft void, no ledger row).
          || (isActiveMember(f)
            && ownsContribution(before)
            && before.status == 'pending'
            && !('voidedAt' in before.keys())
            && a.hasOnly(['voidedAt', 'voidedBy', 'updatedAt', 'updatedBy'])
            && after.get('voidedBy', '') == request.auth.uid)
          // Owner asks to change an APPROVED contribution.
          || (isActiveMember(f)
            && before.memberId == request.auth.uid
            && before.status == 'approved'
            && !('voidedAt' in before.keys())
            && !('pendingChange' in before.keys())
            && a.hasOnly(['pendingChange', 'updatedAt', 'updatedBy']))
          // Manager approves a PENDING request; the ledger row is written in
          // the same batch.
          || (financeManager(f)
            && before.status == 'pending'
            && !('voidedAt' in before.keys())
            && after.status == 'approved'
            && a.hasOnly(['status', 'fundTxId', 'decidedBy', 'decidedAt',
                          'updatedAt', 'updatedBy'])
            && after.get('decidedBy', '') == request.auth.uid
            && contributionLedgerOk(f, c, after))
          // Manager rejects a PENDING request (a reason is required).
          || (financeManager(f)
            && before.status == 'pending'
            && !('voidedAt' in before.keys())
            && after.status == 'rejected'
            && a.hasOnly(['status', 'rejectReason', 'decidedBy', 'decidedAt',
                          'updatedAt', 'updatedBy'])
            && after.get('decidedBy', '') == request.auth.uid)
          // Manager approves a change: the stored request becomes the values.
          || (financeManager(f)
            && before.status == 'approved'
            && !('voidedAt' in before.keys())
            && before.get('pendingChange', null) != null
            && !('pendingChange' in after.keys())
            && after.status == 'approved'
            && a.hasOnly(['amountPaisa', 'dateKey', 'monthKey', 'method',
                          'note', 'pendingChange', 'updatedAt', 'updatedBy'])
            && after.amountPaisa == before.pendingChange.amountPaisa
            && after.dateKey == before.pendingChange.dateKey
            && after.get('method', null)
                 == before.pendingChange.get('method', null)
            && after.get('note', null)
                 == before.pendingChange.get('note', null))
          // Manager declines a change: only the request disappears.
          || (financeManager(f)
            && before.status == 'approved'
            && !('voidedAt' in before.keys())
            && before.get('pendingChange', null) != null
            && !('pendingChange' in after.keys())
            && a.hasOnly(['pendingChange', 'updatedAt', 'updatedBy']))
          // Manager voids an APPROVED contribution (the compensating ledger
          // row is the use case's job; the rows are append-only).
          || (financeManager(f)
            && before.status == 'approved'
            && !('voidedAt' in before.keys())
            && a.hasOnly(['voidedAt', 'voidedBy', 'pendingChange',
                          'updatedAt', 'updatedBy'])
            && after.get('voidedBy', '') == request.auth.uid
            && !('pendingChange' in after.keys()))
        );
    }
    // A month's plan for one member.  The id is `<yyyy-MM>_<memberId>`.
    function contributionPlanOk(d, id) {
      return d.keys().hasOnly(contributionPlanKeys())
        && monthKeyOk(d.get('monthKey', ''))
        && str(d.get('memberId', ''), 1, 64)
        && id == d.monthKey + '_' + d.memberId
        && moneyOk(d, 'expectedPaisa');
    }

    // ── Phase 2 expense / ledger shapes (P2-10) ────────────────────────────
    function isNonNegativeIntOrNull(d, k) {
      return !(k in d.keys()) || d[k] == null || isNonNegativeInt(d[k]);
    }
    function expensePath(f, e) {
      return /databases/$(database)/documents/families/$(f)/expenses/$(e);
    }
    function closingPath(f, mk) {
      return /databases/$(database)/documents/families/$(f)/monthClosings/$(mk);
    }
    // A closed month rejects new ledger/expense rows.  Missing closing = open.
    function monthOpen(f, mk) {
      return !exists(closingPath(f, mk))
        || get(closingPath(f, mk)).data.get('status', 'open') != 'closed';
    }
    function expenseOwner(f, e) {
      return exists(expensePath(f, e))
        && get(expensePath(f, e)).data.get('createdBy', '') == request.auth.uid;
    }
    // D-P2-5: contributions are visible to every active member by default.
    // The switch only exists for families that want to restrict the list.
    function canViewAllContributions(f) {
      return isActiveMember(f)
        && (financeManager(f)
            || !exists(permissionsPath(f))
            || get(permissionsPath(f)).data
                .get('membersViewAllContributions', true) == true);
    }
    function expenseOk(d) {
      return d.keys().hasOnly(expenseKeys())
        && dateKeyOk(d.get('dateKey', ''))
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && d.get('occurredAt', null) is timestamp
        && optStr(d, 'itemId', 64)
        && str(d.get('itemName', ''), 1, 80)
        && str(d.get('categoryId', ''), 1, 64)
        && isNonNegativeIntOrNull(d, 'qtyMilli')
        && (!('unit' in d.keys())
            || d.unit == null
            || d.unit in ['kg', 'g', 'litre', 'piece', 'dozen', 'packet',
                          'cylinder'])
        && isNonNegativeIntOrNull(d, 'unitPricePaisa')
        && moneyOk(d, 'totalPaisa')
        && d.totalPaisa > 0
        && d.get('fundingSource', '') in ['fund', 'member']
        && d.get('reimbursable', false) is bool
        // A fund row never names a payer; a member row always does.
        && ((d.fundingSource == 'fund') == (d.get('paidByMemberId', null) == null))
        && (d.fundingSource == 'member' || d.reimbursable == false)
        && optStr(d, 'paidByMemberId', 64)
        && optStr(d, 'purchaserId', 64)
        && optStr(d, 'tripId', 64)
        && optStr(d, 'shop', 60)
        && optStr(d, 'note', 500)
        && d.get('source', 'manual') in ['manual', 'import']
        && optStr(d, 'importBatchId', 64);
    }
    function tripOk(d) {
      return d.keys().hasOnly(tripKeys())
        && dateKeyOk(d.get('dateKey', ''))
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && optStr(d, 'shop', 60)
        && d.get('fundingSource', '') in ['fund', 'member']
        && d.get('reimbursable', false) is bool
        && ((d.fundingSource == 'fund') == (d.get('paidByMemberId', null) == null))
        && (d.fundingSource == 'member' || d.reimbursable == false)
        && optStr(d, 'paidByMemberId', 64)
        && d.get('lineCount', 0) is int
        && d.lineCount >= 1 && d.lineCount <= 40
        && moneyOk(d, 'totalPaisa')
        && d.totalPaisa > 0
        && optStr(d, 'note', 500);
    }
    function revisionOk(d) {
      return d.keys().hasOnly(revisionKeys())
        && d.get('before', null) is map
        && d.before.size() <= 20
        && d.get('changedFields', null) is list
        && d.changedFields.size() <= 20
        && optStr(d, 'reason', 200)
        && d.get('createdAt', null) is timestamp
        && d.get('updatedAt', null) is timestamp;
    }
    function fundTxOk(f, d, t) {
      return d.keys().hasOnly(fundTxKeys())
        && d.get('type', '') in ['contribution', 'expense', 'reimbursement',
                                'opening', 'adjustment']
        && d.get('refType', '') in ['expense', 'contribution', 'settlement',
                                   'month', 'manual']
        && str(d.get('refId', ''), 1, 64)
        && dateKeyOk(d.get('dateKey', ''))
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && d.get('amountPaisa', 0) is int
        && d.amountPaisa != 0
        && optStr(d, 'note', 300)
        && (
          (d.type == 'expense'
            && isActiveMember(f)
            && d.amountPaisa < 0
            && d.refType == 'expense'
            && t == 'exp_' + d.refId)
          || (d.type == 'contribution'
            && financeManager(f)
            && d.amountPaisa > 0
            && d.refType == 'contribution'
            && t == 'con_' + d.refId)
          || (d.type == 'reimbursement'
            && financeManager(f)
            && d.amountPaisa < 0
            && d.refType == 'settlement'
            && t == 'stl_' + d.refId)
          || (d.type == 'opening'
            // P2-21: CloseMonth carries the balance into the next month, so the
            // person who may close (admin, or a finance moderator — the same
            // `financeManager`) also writes this one row, in the SAME batch as
            // the closing document.  A moderating member without finance rights
            // and a plain member are still denied.
            && financeManager(f)
            && getAfter(closingPath(f, d.monthKey)).data.get('status', '') ==
                 'closed'
            && d.refType == 'month'
            && d.refId == d.monthKey
            && t == 'open_' + d.refId)
          || (d.type == 'opening'
            && isAdmin(f)
            && d.refType == 'month'
            && d.refId == d.monthKey
            && t == 'open_' + d.refId)
          || (d.type == 'adjustment'
            && t.matches('^adj_[A-Za-z0-9_-]+$')
            && ((d.refType == 'expense' && isActiveMember(f))
                || (d.refType != 'expense' && financeManager(f))))
        );
    }
    function advanceOk(d) {
      let amount = d.get('amountPaisa', -1);
      let settled = d.get('settledPaisa', -1);
      return d.keys().hasOnly(advanceKeys())
        && str(d.get('expenseId', ''), 1, 64)
        && str(d.get('memberId', ''), 1, 64)
        && isNonNegativeInt(amount)
        && isNonNegativeInt(settled)
        && settled <= amount
        && d.get('status', '') in ['pending', 'partial', 'settled', 'voided']
        && dateKeyOk(d.get('dateKey', ''))
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && (
          d.status == 'voided'
          || (d.status == 'pending' && settled == 0)
          || (d.status == 'partial' && settled > 0 && settled < amount)
          || (d.status == 'settled' && amount > 0 && settled == amount)
        );
    }
    function settlementOk(d, s) {
      return d.keys().hasOnly(settlementKeys())
        && str(d.get('advanceId', ''), 1, 64)
        && str(d.get('memberId', ''), 1, 64)
        && moneyOk(d, 'amountPaisa')
        && d.amountPaisa > 0
        && dateKeyOk(d.get('dateKey', ''))
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('dateKey', '').matches('^' + d.get('monthKey', '') + '-[0-9]{2}$')
        && optStr(d, 'method', 20)
        && optStr(d, 'note', 300)
        && d.get('fundTxId', '') == 'stl_' + s;
    }
    function closingOk(d, month) {
      return d.keys().hasOnly(closingKeys())
        && d.get('monthKey', '') == month
        && monthKeyOk(d.get('monthKey', ''))
        && d.get('status', '') in ['open', 'closed']
        && (!('closedAt' in d.keys())
            || d.closedAt == null
            || d.closedAt is timestamp)
        && optStr(d, 'closedBy', 64)
        && (!('closingBalancePaisa' in d.keys())
            || d.closingBalancePaisa == null
            || d.closingBalancePaisa is int)
        && (!('reopenedAt' in d.keys())
            || d.reopenedAt == null
            || d.reopenedAt is timestamp)
        && optStr(d, 'reopenedBy', 64)
        && optStr(d, 'reopenNote', 300)
        && d.get('reopenCount', 0) is int
        && d.reopenCount >= 0;
    }

    // ── Log integrity (H5) ─────────────────────────────────────────────────
    // The closed `type`/`refType` lists, mirrored by
    // lib/core/audit/audit_event_type.dart and audit_ref_type.dart (compared to
    // these literals by test/core/audit/audit_event_type_test.dart).
    function eventTypes() {
      return ['family.created', 'member.requested', 'member.approved',
              'member.rejected', 'member.disabled', 'member.role_changed',
              'member.admin_transferred', 'member.left', 'member.cancelled',
              'invitation.created', 'invitation.revoked', 'family.updated',
              // Phase 2 bazar vocabulary (roadmap section 3.9).
              'bazar.catalog_seeded', 'bazar.category_created',
              'bazar.category_updated', 'bazar.category_deactivated',
              'bazar.item_created', 'bazar.item_updated',
              'bazar.item_deactivated', 'bazar.expense_created',
              'bazar.expense_updated', 'bazar.expense_deleted',
              'bazar.expense_restored', 'bazar.trip_created',
              'bazar.budget_saved', 'bazar.settings_updated',
              'bazar.contribution_plan_set', 'bazar.contribution_recorded',
              'bazar.contribution_voided', 'bazar.contribution_requested',
              'bazar.contribution_request_edited',
              'bazar.contribution_request_cancelled',
              'bazar.contribution_approved', 'bazar.contribution_rejected',
              'bazar.contribution_change_requested',
              'bazar.contribution_change_approved',
              'bazar.contribution_change_rejected',
              'bazar.opening_balance_set', 'bazar.advance_settled',
              'bazar.month_closed', 'bazar.month_reopened',
              'bazar.import_completed', 'bazar.import_undone',
              // Phase 3 chores vocabulary (road map 3.9).
              'chores.settings_updated', 'chores.rotation_policy_updated',
              'chores.template_created', 'chores.template_updated',
              'chores.template_paused', 'chores.template_resumed',
              'chores.template_archived', 'chores.template_duplicated',
              'chores.starter_pack_applied', 'chores.duty_group_created',
              'chores.duty_group_updated', 'chores.rotation_changed',
              'chores.occurrences_generated', 'chores.occurrences_replanned',
              'chores.occurrence_completed', 'chores.occurrence_uncompleted',
              'chores.occurrence_verified', 'chores.occurrence_reopened',
              'chores.occurrence_exception', 'chores.occurrence_skipped',
              'chores.occurrence_unskipped', 'chores.occurrence_reassigned',
              'chores.comment_added', 'chores.comment_hidden',
              'chores.availability_added', 'chores.availability_cancelled',
              'chores.availability_decided', 'chores.swap_requested',
              'chores.swap_accepted', 'chores.swap_declined',
              'chores.swap_cancelled', 'chores.swap_expired',
              'chores.cover_assigned'];
    }
    function refTypes() {
      return ['family', 'member', 'invitation',
              // Phase 2 bazar vocabulary (roadmap section 3.9).
              'category', 'item', 'expense', 'trip', 'budget',
              'contribution', 'contributionPlan', 'settlement', 'month',
              'importBatch',
              // Phase 3 chores vocabulary (road map 3.9).
              'choreSettings', 'choreTemplate', 'dutyGroup', 'occurrence',
              'comment', 'availability', 'swapRequest'];
    }
    function paramsOk(d) {
      return !('params' in d.keys())
        || (d.params is map && d.params.size() <= 8);
    }
    // An append-only log entry: written by its own actor, with a known shape and
    // a SERVER timestamp.  `createdAt` is the device clock and is deliberately
    // NOT compared with request.time (a queued offline write would be refused).
    function eventOk(d) {
      return createsAsSelf()
        && d.get('actorId', '') == request.auth.uid
        && d.get('type', '') in eventTypes()
        && d.get('refType', '') in refTypes()
        && str(d.get('refId', ''), 0, 64)
        && optStr(d, 'summary', 200)
        && paramsOk(d)
        && d.get('recordedAt', null) == request.time
        && d.keys().hasOnly(eventKeys());
    }

    // ── Family membership helpers (roadmap Section 13 names) ───────────────
    function familyPath(f) {
      return /databases/$(database)/documents/families/$(f);
    }
    function memberPath(f, uid) {
      return /databases/$(database)/documents/families/$(f)/members/$(uid);
    }
    // The caller's member document, or an empty map when there is none.
    //
    // The empty-map fallback matters: in rules an *error* in an operand makes
    // the whole condition an error, and `get(...).data` on a missing document
    // is exactly such an error.  With `{}` every helper below is a clean false
    // instead, so a denial is reported for the right reason.
    function me(f) {
      return exists(memberPath(f, request.auth.uid))
        ? get(memberPath(f, request.auth.uid)).data
        : {};
    }
    function isMember(f) {
      return signedIn() && exists(memberPath(f, request.auth.uid));
    }
    function role(f) {
      return me(f).get('role', '');
    }
    // Active = approved, and not rejected (soft delete) or disabled.
    function isActiveMember(f) {
      return signedIn()
        && me(f).get('status', 'pending') == 'active'
        && me(f).get('removedAt', null) == null;
    }
    function isAdmin(f) {
      return isActiveMember(f) && role(f) == 'admin';
    }
    function isMod(f) {
      return isActiveMember(f) && role(f) == 'moderator';
    }
    // Admin or moderator: may invite and decide requests (Step 9 rule).
    function isManager(f) {
      return isAdmin(f) || isMod(f);
    }
    // The catalog and budgets are finance-managed: an admin always, a moderator
    // only while `settings/permissions.moderatorManagesFinance` is true
    // (missing document/key = true, the domain default).
    function financeManager(f) {
      return isAdmin(f)
        || (isMod(f)
            && (exists(permissionsPath(f))
                ? get(permissionsPath(f)).data
                    .get('moderatorManagesFinance', true) == true
                : true));
    }

    // ── Member invitations (H7) ────────────────────────────────────────────
    // `settings/permissions.membersCanInvite` lets plain members create (and
    // revoke their own) invitations.  Absent document or key = false.
    function permissionsPath(f) {
      return /databases/$(database)/documents/families/$(f)/settings/permissions;
    }
    function membersMayInvite(f) {
      return isActiveMember(f)
        && exists(permissionsPath(f))
        && get(permissionsPath(f)).data.get('membersCanInvite', false) == true;
    }
    function canInvite(f) {
      return isManager(f) || membersMayInvite(f);
    }

    // ── Active-admin set (H6) ──────────────────────────────────────────────
    // `families/{f}.adminIds` is the denormalised list of ACTIVE admins.  The
    // rules re-check it against the member documents, so a forged list is
    // rejected and the family can never be left without an admin.
    function isActiveAdminData(d) {
      return d.get('role', '') == 'admin'
        && d.get('status', '') == 'active'
        && d.get('removedAt', null) == null
        && d.get('leftAt', null) == null;
    }
    // Index [i] of `ids` names an active admin after the batch.  The size guard
    // keeps the list index in range (evaluated first, `||` short-circuits).
    function adminAfterOk(f, ids, i) {
      return i >= ids.size()
        || isActiveAdminData(getAfter(memberPath(f, ids[i])).data);
    }
    // The family document after a write: 1..3 uids, each an active admin.
    function adminIdsOk(f) {
      let ids = request.resource.data.get('adminIds', []);
      return ids.size() >= 1
        && ids.size() <= 3
        && adminAfterOk(f, ids, 0)
        && adminAfterOk(f, ids, 1)
        && adminAfterOk(f, ids, 2);
    }
    // A newly created family has exactly its creator as its only admin.
    function creatorIsAdmin() {
      let ids = request.resource.data.get('adminIds', []);
      return ids.size() == 1 && ids[0] == request.auth.uid;
    }
    // Did this member write change whether the member is an active admin?
    function adminSetChanges() {
      return isActiveAdminData(resource.data)
        != isActiveAdminData(request.resource.data);
    }
    // The family document must be part of THIS batch and its `adminIds` must
    // change (a no-op family write does not satisfy the requirement).
    function adminIdsRewritten(f) {
      return getAfter(familyPath(f)).data.diff(get(familyPath(f)).data)
        .affectedKeys().hasAny(['adminIds']);
    }

    // ── Enrollment helpers ────────────────────────────────────────────────
    // True only inside the ONE batch that creates a family: the family document
    // does not exist yet and the caller is its creator.
    function creatingFamily(f) {
      return verified()
        && !exists(/databases/$(database)/documents/families/$(f))
        && getAfter(/databases/$(database)/documents/families/$(f)).data.createdBy
             == request.auth.uid;
    }
    function codeDoc(code) {
      return exists(/databases/$(database)/documents/inviteCodes/$(code))
        ? get(/databases/$(database)/documents/inviteCodes/$(code)).data
        : {};
    }
    function liveCode(code) {
      return codeDoc(code).get('status', '') == 'active'
        // A missing timestamp defaults to "now", which is never > now.
        && codeDoc(code).get('expiresAt', request.time) > request.time;
    }
    // A joining member document: pending, plain member, created by the joiner,
    // backed by a live code for this family.
    function validJoin(f) {
      return verified()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('role', '') == 'member'
        && request.resource.data.get('uid', '') == request.auth.uid
        && createsAsSelf()
        && memberProfileOk(request.resource.data)
        && request.resource.data.keys().hasOnly(memberKeys())
        && request.resource.data.get('inviteCode', null) is string
        && liveCode(request.resource.data.inviteCode)
        && codeDoc(request.resource.data.inviteCode).get('familyId', '') == f;
    }
    // A self-write may never change who it is...
    function identityStable() {
      return request.resource.data.uid == resource.data.uid;
    }
    // ...nor promote itself...
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }
    // ...nor approve itself.
    function statusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }
    // What a decision on a pending request may produce: approve, reject
    // (back to pending, with removedAt) or decline a pending request.
    function validDecision() {
      return (request.resource.data.status == 'active'
              && request.resource.data.get('removedAt', null) == null)
        || request.resource.data.status == 'disabled'
        || (request.resource.data.status == 'pending'
            && request.resource.data.get('removedAt', null) != null);
    }
    // True inside the ONE batch that creates the caller's pending member
    // document.  The activity and audit entries of that batch are written by
    // the same user, so they use this instead of `validJoin` (their own
    // document has no `status` or `role` field to inspect).
    function joiningNow(f) {
      return verified()
        && existsAfter(memberPath(f, request.auth.uid))
        && getAfter(memberPath(f, request.auth.uid)).data.get('status', '') == 'pending'
        && getAfter(memberPath(f, request.auth.uid)).data.get('role', '') == 'member';
    }
    // The member document the caller is creating in THIS batch is a pending
    // plain member backed by [code] (H5).  Used to require that burning an
    // invite and joining happen atomically.
    function pendingJoinAfter(f, code) {
      return existsAfter(memberPath(f, request.auth.uid))
        && getAfter(memberPath(f, request.auth.uid)).data.get('status', '') == 'pending'
        && getAfter(memberPath(f, request.auth.uid)).data.get('inviteCode', null) == code;
    }
    function memberDocIsValid() {
      return inList(request.resource.data.get('role', 'member'),
                    ['admin', 'moderator', 'member'])
        && inList(request.resource.data.get('status', 'pending'),
                  ['pending', 'active', 'disabled'])
        && request.resource.data.get('uid', '') is string
        && memberProfileOk(request.resource.data)
        && request.resource.data.keys().hasOnly(memberKeys());
    }

    // ══════════════════════════════════════════════════════════════════════
    // users/{uid} — the owner only.  Holds the profile, `familyId` and
    // `preferences {themeId, themeMode, language, banglaDigits}`.
    //
    // The owner may write this WITHOUT a verified email (the verification
    // screen and the preference sync run before verification).
    // ══════════════════════════════════════════════════════════════════════
    match /users/{uid} {
      // The document may exist before the profile does (preference sync merges
      // `preferences` into it), so every profile field is optional — but the
      // ones that are present must be well formed, and the owner may never
      // claim to be somebody else.
      function userDocOk() {
        return request.resource.data.get('uid', uid) == uid
          && (!('familyId' in request.resource.data.keys())
              || request.resource.data.get('familyId', null) is string)
          && request.resource.data.get('updatedBy', uid) == uid
          && optStr(request.resource.data, 'fullName', 80)
          && optStr(request.resource.data, 'nickname', 40)
          && accountDeletionOk()
          && preferencesOk(request.resource.data)
          && relationshipOk(request.resource.data)
          && genderOk(request.resource.data);
      }

      // H9: an owner may soft-delete their own account: `deletedAt` is a
      // timestamp, `deletedBy` is the owner, and a deletion can never be undone
      // (once set, `deletedAt` stays set).
      function accountDeletionOk() {
        let d = request.resource.data;
        return (!('deletedAt' in d.keys()) || d.deletedAt == null || d.deletedAt is timestamp)
          && (!('deletedBy' in d.keys()) || d.deletedBy == null || d.deletedBy == uid)
          && (!('deletedAt' in d.keys()) || d.deletedAt != null || !(resource != null && resource.data.get('deletedAt', null) != null));
      }

      // One family per user (CLAUDE.md rule 17): `familyId` may be set when
      // absent, kept as it is, or moved once the OLD membership is gone (the
      // member document is missing, rejected, cancelled or left).  Pending,
      // active and admin-disabled members cannot be pointed elsewhere.
      function familyPointerChangeOk() {
        let before = resource.data.get('familyId', null);
        let after = request.resource.data.get('familyId', null);
        return before == null
          || before == after
          || !exists(memberPath(before, uid))
          || get(memberPath(before, uid)).data.get('removedAt', null) != null;
      }

      allow get, list: if isSelf(uid);
      allow create: if isSelf(uid) && userDocOk();
      allow update: if isSelf(uid) && userDocOk() && familyPointerChangeOk();
      // H9: an account is closed by a SOFT delete (`deletedAt`, `deletedBy`);
      // the document itself is never removed, so history stays attributable.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // inviteCodes/{code} — the discovery index for joining.
    //
    // Exact-id `get` only, never `list`: a signed-in, VERIFIED user with a code
    // may learn the family it belongs to, nobody may enumerate codes or
    // families.
    // ══════════════════════════════════════════════════════════════════════
    match /inviteCodes/{code} {
      allow get: if verified();
      allow list: if false;

      allow create: if verified()
        && request.resource.data.familyId is string
        && request.resource.data.familyId.size() > 0
        && canInvite(request.resource.data.familyId)
        && createsAsSelf()
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'member'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(invitationKeys());

      // A joiner marks their code used IN THE SAME BATCH that creates their
      // pending member document (H5); nothing else may change, ever.
      allow update: if verified()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'usedBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(invitationKeys())
        && pendingJoinAfter(resource.data.familyId, code);

      // A manager of the code's family (or the member who created it, while
      // members may invite) revokes a still-active code; nothing else may
      // change.
      allow update: if verified()
        && resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && (isManager(resource.data.familyId)
            || (membersMayInvite(resource.data.familyId)
                && resource.data.createdBy == request.auth.uid))
        && writesAsSelf()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(invitationKeys());

      // An expired or revoked code is a tombstone, not a deleted document.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // families/{f}
    // ══════════════════════════════════════════════════════════════════════
    match /families/{f} {
      allow create: if verified()
        && createsAsSelf()
        && str(request.resource.data.get('name', ''), 1, 80)
        && creatorIsAdmin()
        && request.resource.data.keys().hasOnly(familyKeys());

      // Active members only: a pending or rejected user reads nothing here,
      // and a member of another family reads nothing.
      allow read: if isActiveMember(f);

      // Family administration.  `editFamilySettings` is admin-only, so a
      // moderator cannot rename the family or flip a module.
      allow update: if isAdmin(f)
        && writesAsSelf()
        && str(request.resource.data.get('name', ''), 1, 80)
        && adminIdsOk(f)
        && request.resource.data.keys().hasOnly(familyKeys());

      allow delete: if false;

      // ── members/{m} ────────────────────────────────────────────────────
      match /members/{m} {
        // A member sees the family roster; everyone may read their own
        // document so the pending screen can listen to it.
        allow read: if isActiveMember(f) || isSelf(m);

        // 1. Creating the family: the first member is an active admin.
        allow create: if isSelf(m)
          && verified()
          && creatingFamily(f)
          && createsAsSelf()
          && request.resource.data.get('role', '') == 'admin'
          && request.resource.data.get('status', '') == 'active'
          && memberProfileOk(request.resource.data)
          && request.resource.data.keys().hasOnly(memberKeys());

        // 2. Joining with a live code: pending, plain member.
        allow create: if isSelf(m) && validJoin(f);

        // 3. Admin: any change (role, status, removal) — the last-admin guard
        //    lives in the domain, see the header.  A REMOVED member (rejected,
        //    cancelled or left) can never be revived by a write: they may belong
        //    to another family by now (rule 17); they must join again (rule 5).
        allow update: if isAdmin(f)
          && verified()
          && resource.data.get('removedAt', null) == null
          && resource.data.get('leftAt', null) == null
          && writesAsSelf()
          && memberDocIsValid()
          && request.resource.data.get('uid', '') == m
          // H6: a change to the active-admin set must rewrite the family doc.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 4. Moderator: decide a PENDING request only — approve, reject or
        //    decline.  Never a role, never an active member (roadmap Step 10,
        //    "moderator approve-only").
        allow update: if isMod(f)
          && verified()
          && writesAsSelf()
          && resource.data.get('status', 'pending') == 'pending'
          && resource.data.get('removedAt', null) == null
          && resource.data.get('leftAt', null) == null
          && identityStable()
          && roleUnchanged()
          && validDecision()
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'removedAt', 'updatedAt', 'updatedBy'])
          // H6: approving a pending admin still changes the active-admin set.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 5. A rejected person may ask again with a fresh code.
        allow update: if isSelf(m)
          && resource.data.get('removedAt', null) != null
          && validJoin(f);

        // 6. A member edits their own profile fields — never role or status,
        //    and never anyone else's document.
        allow update: if isSelf(m)
          && verified()
          && isActiveMember(f)
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && statusUnchanged()
          && memberProfileOk(request.resource.data)
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['fullName', 'nickname', 'relationship', 'spouseId',
                         'avatarKey', 'inviteCode', 'updatedAt', 'updatedBy']);

        // 7. LEAVE: an active member leaves on their own.  The document is kept
        //    (history): status becomes `disabled` and `leftAt` / `removedAt`
        //    carry the same timestamp.  Role never changes.
        allow update: if isSelf(m)
          && verified()
          && isActiveMember(f)
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && request.resource.data.status == 'disabled'
          && request.resource.data.get('leftAt', null) is timestamp
          && request.resource.data.get('removedAt', null)
               == request.resource.data.get('leftAt', null)
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'leftAt', 'removedAt', 'updatedAt',
                         'updatedBy'])
          // H6: an admin leaving changes the active-admin set.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 8. CANCEL: a pending person withdraws their own request.  Only
        //    `removedAt` (the same soft delete a rejection uses) changes.
        allow update: if isSelf(m)
          && verified()
          && resource.data.get('status', '') == 'pending'
          && resource.data.get('removedAt', null) == null
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && statusUnchanged()
          && request.resource.data.get('removedAt', null) is timestamp
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['removedAt', 'updatedAt', 'updatedBy']);

        // Leaving and removal are soft (removedAt / status), never hard.
        allow delete: if false;
      }

      // ── invitations/{i} — the family-side mirror of inviteCodes ────────
      match /invitations/{i} {
        allow read: if isManager(f) || membersMayInvite(f);
        allow create: if verified()
          && (canInvite(f) || creatingFamily(f))
          && createsAsSelf()
          && request.resource.data.familyId == f
          && request.resource.data.keys().hasOnly(invitationKeys());
        // A joiner marks the mirror used IN THE SAME BATCH that creates their
        // pending member document (H5); a manager revokes a still-active code.
        allow update: if verified()
          && resource.data.get('status', '') == 'active'
          && request.resource.data.get('status', '') in ['used', 'revoked']
          && request.resource.data.keys().hasOnly(invitationKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'usedBy', 'updatedAt', 'updatedBy'])
          && (
            (
              request.resource.data.status == 'revoked'
              && (isManager(f)
                  || (membersMayInvite(f)
                      && resource.data.get('createdBy', '')
                           == request.auth.uid))
              && writesAsSelf()
            )
            || (
              request.resource.data.status == 'used'
              && request.resource.data.get('usedBy', '') == request.auth.uid
              && pendingJoinAfter(f, i)
            )
          );
        allow delete: if false;
      }

      // ── bazarCategories/{c} — catalog managers (P2-05) ─────────────────
      match /bazarCategories/{c} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && (financeManager(f) || creatingFamily(f))
          && createsAsSelf()
          && categoryOk(request.resource.data);
        // `createdAt`, `createdBy`, `builtIn` and `seedKey` are immutable.
        allow update: if verified()
          && financeManager(f)
          && writesAsSelf()
          && categoryOk(request.resource.data)
          && request.resource.data.get('createdAt', null)
               == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', '')
               == resource.data.get('createdBy', '')
          && request.resource.data.get('builtIn', false)
               == resource.data.get('builtIn', false)
          && request.resource.data.get('seedKey', null)
               == resource.data.get('seedKey', null);
        allow delete: if false;
      }

      // ── bazarItems/{i} — managers + everyday member usage (P2-05) ──────
      match /bazarItems/{i} {
        allow read: if canReadFamilyData(f);
        // A member may add a custom item ("Remember this item"); a built-in
        // item is seeded or manager-created only.
        allow create: if verified()
          && (financeManager(f)
              || creatingFamily(f)
              || (isActiveMember(f)
                  && request.resource.data.get('builtIn', true) == false
                  && request.resource.data.get('useCount', -1) == 0))
          && createsAsSelf()
          && itemOk(request.resource.data);
        allow update: if verified()
          && (
            // Managers edit the catalog; usage and last prices are untouched
            // by `itemChangeMap`, and the immutable fields cannot move.
            (financeManager(f)
              && writesAsSelf()
              && itemOk(request.resource.data)
              && request.resource.data.get('createdAt', null)
                   == resource.data.get('createdAt', null)
              && request.resource.data.get('createdBy', '')
                   == resource.data.get('createdBy', '')
              && request.resource.data.get('builtIn', false)
                   == resource.data.get('builtIn', false)
              && request.resource.data.get('seedKey', null)
                   == resource.data.get('seedKey', null))
            // Any active member records a purchase: only the usage fields may
            // change, and one write may add 1..40 uses (D-P2-7).
            || (isActiveMember(f)
              && writesAsSelf()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['useCount', 'lastPricePaisa', 'lastUnitPricePaisa',
                             'lastUsedAt', 'updatedAt', 'updatedBy'])
              && request.resource.data.get('useCount', 0) is int
              && request.resource.data.get('useCount', 0)
                   - resource.data.get('useCount', 0) > 0
              && request.resource.data.get('useCount', 0)
                   - resource.data.get('useCount', 0) <= 40
              && isNonNegativeIntOrMissing(request.resource.data,
                                           'lastPricePaisa')
              && isNonNegativeIntOrMissing(request.resource.data,
                                           'lastUnitPricePaisa')
              && (!('lastUsedAt' in request.resource.data.keys())
                  || request.resource.data.lastUsedAt == null
                  || request.resource.data.lastUsedAt is timestamp))
          );
        allow delete: if false;
      }

      // ── expenses/{e} — one row per purchase (P2-10) ─────────────────────
      match /expenses/{e} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && isActiveMember(f)
          && createsAsSelf()
          && expenseOk(request.resource.data)
          && monthOpen(f, request.resource.data.monthKey);
        // Two update paths: the four soft-delete stamps, or a content edit.
        // Both freeze the provenance fields and respect a closed month.
        allow update: if verified()
          && isActiveMember(f)
          && writesAsSelf()
          && (resource.data.get('createdBy', '') == request.auth.uid
              || isManager(f))
          && (
            (softDeleteOnly()
              && expenseOk(request.resource.data)
              && monthOpen(f, resource.data.monthKey)
              && (!('deletedAt' in request.resource.data.keys())
                  || request.resource.data.deletedAt == null
                  || request.resource.data.deletedAt is timestamp)
              && (!('deletedBy' in request.resource.data.keys())
                  || request.resource.data.deletedBy == null
                  || request.resource.data.deletedBy == request.auth.uid))
            || (expenseOk(request.resource.data)
              && request.resource.data.get('createdAt', null)
                   == resource.data.get('createdAt', null)
              && request.resource.data.get('createdBy', '')
                   == resource.data.get('createdBy', '')
              && request.resource.data.get('source', 'manual')
                   == resource.data.get('source', 'manual')
              && request.resource.data.get('importBatchId', null)
                   == resource.data.get('importBatchId', null)
              && request.resource.data.get('tripId', null)
                   == resource.data.get('tripId', null)
              && monthOpen(f, resource.data.monthKey)
              && monthOpen(f, request.resource.data.monthKey))
          );
        allow delete: if false;

        // Append-only edit history.  Only the manager or the expense's creator
        // may read it; every active member may append their own entry.
        match /revisions/{r} {
          allow read: if isActiveMember(f)
            && (isManager(f) || expenseOwner(f, e));
          allow create: if verified()
            && isActiveMember(f)
            && createsAsSelf()
            && revisionOk(request.resource.data)
            && (isManager(f) || expenseOwner(f, e));
          allow update, delete: if false;
        }
      }

      // ── bazarTrips/{t} — immutable trip header (P2-10) ──────────────────
      match /bazarTrips/{t} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && isActiveMember(f)
          && createsAsSelf()
          && tripOk(request.resource.data)
          && monthOpen(f, request.resource.data.monthKey);
        allow update, delete: if false;
      }

      // ── fundTransactions/{t} — append-only signed ledger (P2-10) ────────
      match /fundTransactions/{t} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && createsAsSelf()
          && fundTxOk(f, request.resource.data, t)
          && monthOpen(f, request.resource.data.monthKey);
        allow update, delete: if false;
      }

      // ── memberAdvances/{a} — one advance per member-funded expense ──────
      match /memberAdvances/{a} {
        allow read: if isManager(f)
          || (isActiveMember(f)
              && resource.data.get('memberId', '') == request.auth.uid);
        allow create: if verified()
          && isActiveMember(f)
          && createsAsSelf()
          && advanceOk(request.resource.data)
          && request.resource.data.get('expenseId', '') == a
          && request.resource.data.get('status', '') == 'pending'
          && request.resource.data.get('settledPaisa', -1) == 0
          && monthOpen(f, request.resource.data.monthKey);
        // SettleAdvance only moves the settlement progress; an edit/void is
        // allowed only while the advance is still unpaid.
        allow update: if verified()
          && isActiveMember(f)
          && writesAsSelf()
          && advanceOk(request.resource.data)
          && request.resource.data.get('expenseId', '') == a
          && (
            (financeManager(f)
              && resource.data.get('status', '') in ['pending', 'partial']
              && request.resource.data.get('status', '') in ['partial', 'settled']
              && request.resource.data.get('amountPaisa', -1)
                   == resource.data.get('amountPaisa', -2)
              && request.resource.data.get('memberId', '')
                   == resource.data.get('memberId', '')
              && request.resource.data.get('dateKey', '')
                   == resource.data.get('dateKey', '')
              && request.resource.data.get('monthKey', '')
                   == resource.data.get('monthKey', '')
              && request.resource.data.get('settledPaisa', -1)
                   > resource.data.get('settledPaisa', -2))
            || ((isManager(f) || expenseOwner(f, resource.data.get('expenseId', '')))
              && resource.data.get('settledPaisa', -1) == 0
              && request.resource.data.get('settledPaisa', -2) == 0
              && request.resource.data.get('status', '') in ['pending', 'voided'])
          );
        allow delete: if false;
      }

      // ── settlements/{s} — append-only advance reimbursements (P2-10) ────
      match /settlements/{s} {
        allow read: if isManager(f)
          || (isActiveMember(f)
              && resource.data.get('memberId', '') == request.auth.uid);
        allow create: if verified()
          && financeManager(f)
          && createsAsSelf()
          && settlementOk(request.resource.data, s)
          && monthOpen(f, request.resource.data.monthKey);
        allow update, delete: if false;
      }

      // ── monthClosings/{month} — close/reopen history (P2-10) ────────────
      match /monthClosings/{month} {
        allow read: if isActiveMember(f);
        allow create, update: if verified()
          && financeManager(f)
          && writesAsSelf()
          && closingOk(request.resource.data, month);
        allow delete: if false;
      }

      // ── settings/{s} — general, modules, rotationPolicy, notificationDefaults
      match /settings/{s} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && (isAdmin(f) || (s == 'bazar' && financeManager(f))
              || creatingFamily(f))
          && createsAsSelf()
          && settingsOk(request.resource.data);
        allow update: if verified()
          && (isAdmin(f) || (s == 'bazar' && financeManager(f)))
          && writesAsSelf()
          && settingsOk(request.resource.data);
        allow delete: if false;
      }

      // ── settings/chores — the chore catalogs and preferences (P3-06) ────────
      // A Household Manager may edit them (C-4: the Bazar rule above would have
      // limited this to an admin).  The document is created on first save.
      match /settings/chores {
        allow read: if isActiveMember(f);
        allow create, update: if verified()
          && isManager(f)
          && writesAsSelf()
          && choreSettingsOk(request.resource.data);
        allow delete: if false;
      }

      // ── settings/choreGeneration — the generation marker (P3-06, D-P3-10) ──
      // ANY active member may advance it (a plain member must be able to
      // complete today's chore even if no manager opened the app).  It may only
      // move forward, by at most 120 days per write, and never backwards.
      match /settings/choreGeneration {
        allow read: if isActiveMember(f);
        allow create, update: if verified()
          && isActiveMember(f)
          && writesAsSelf()
          && generationOk(request.resource.data)
          && generationAdvances();
        allow delete: if false;
      }

      // ── settings/rotationPolicy — the absence policy (P3-06, closes C-3) ────
      // The document already exists (written at family creation); only the
      // manager or an admin may change which policy it holds.
      match /settings/rotationPolicy {
        allow read: if isActiveMember(f);
        allow create, update: if verified()
          && isManager(f)
          && writesAsSelf()
          && rotationPolicyOk(request.resource.data);
        allow delete: if false;
      }

      // ── choreTemplates/{id} — templates are never deleted (P3-08) ────────
      // Manager or admin write.  `revision` must increase by EXACTLY one on
      // every update (D-P3-23), and `seedKey` / `builtIn` are immutable, so a
      // starter-pack template cannot be turned into a family-made one (or the
      // reverse) and re-applied.
      match /choreTemplates/{templateId} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && isManager(f)
          && createsAsSelf()
          && templateOk(request.resource.data);
        allow update: if verified()
          && isManager(f)
          && writesAsSelf()
          && templateOk(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.get('seedKey', null)
               == resource.data.get('seedKey', null)
          && request.resource.data.get('builtIn', false)
               == resource.data.get('builtIn', false);
        allow delete: if false;
      }

      // ── dutyGroups/{id} — groups are never deleted (P3-10) ──────────────
      // Manager or admin write.  Switching a group off is ALLOWED even while
      // templates point at it: the use case warns, it does not forbid.
      match /dutyGroups/{groupId} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && isManager(f)
          && createsAsSelf()
          && dutyGroupOk(request.resource.data);
        allow update: if verified()
          && isManager(f)
          && writesAsSelf()
          && dutyGroupOk(request.resource.data);
        allow delete: if false;
      }

      // ── choreOccurrences/{id} — the occurrence state machine (P3-13) ────
      // Any active member may CREATE one (D-P3-7: a plain member must be able to
      // complete today's chore even if no manager opened the app).  The rules
      // check the shape, the deterministic id and `status == scheduled`; they
      // cannot verify rotation correctness (no trusted server on Spark, ADR
      // 0011).  ONE membership lookup on create keeps a 400-document generation
      // batch inside the access-call budget (C-11).
      match /choreOccurrences/{o} {
        // B-11: `before` / `after` were used here without ever being declared
        // (a compile error for the WHOLE ruleset).  These two functions are
        // the declarations; `occurrenceChanged()` is the affected-key set.
        function prev() { return resource.data; }
        function next() { return request.resource.data; }

        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && canReadFamilyData(f)
          && createsAsSelf()
          && occurrenceOk(o, request.resource.data)
          && occurrenceFresh(request.resource.data);

        // 1. TICK / COMPLETE / UNCOMPLETE (M-02: one rule, four branches).
        //    Whoever acts must pass `mayTick` against the PREVIOUS assignee.
        //    The metadata that other rules own never moves here.  A chore can
        //    only be (or stay) `completed` when every required step is ticked
        //    (`subtaskDone.size() >= requiredCount`) or a manager's
        //    `exception` exists (M-01).  Limit: the rules cannot read WHICH
        //    keys were ticked nor who ticked one (CLAUDE.md rule 45), so the
        //    size also counts optional ticks; the use cases are stricter.
        allow update: if verified()
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && mayTick(f, prev())
          && next().get('verifiedAt', null) == prev().get('verifiedAt', null)
          && next().get('verifiedBy', null) == prev().get('verifiedBy', null)
          && next().get('skipReason', null) == prev().get('skipReason', null)
          && next().get('reopenCount', 0) == prev().get('reopenCount', 0)
          && (
            // (a) stays completed: a step is ticked/unticked on a finished
            //     chore by anybody who may tick; completion data unchanged.
            (prev().get('status', '') == 'completed'
              && next().get('status', '') == 'completed'
              && next().get('completedAt', null) == prev().get('completedAt', null)
              && next().get('completedBy', null) == prev().get('completedBy', null)
              && completionValid(next())
              && occurrenceChanged()
                   .hasOnly(['subtaskDone', 'updatedAt', 'updatedBy']))
            // (b) completes: records the REAL actor (D-P3-14).
            || (prev().get('status', '') in ['scheduled', 'in_progress']
              && next().get('status', '') == 'completed'
              && next().get('completedAt', null) is timestamp
              && next().get('completedBy', null) == request.auth.uid
              && completionValid(next())
              && occurrenceChanged()
                   .hasOnly(['subtaskDone', 'status', 'completedAt',
                             'completedBy', 'updatedAt', 'updatedBy']))
            // (c) open -> open: a partial tick; no completion data at all.
            || (prev().get('status', '') in ['scheduled', 'in_progress']
              && next().get('status', '') in ['scheduled', 'in_progress']
              && next().get('completedAt', null) == null
              && next().get('completedBy', null) == null
              && occurrenceChanged()
                   .hasOnly(['subtaskDone', 'status', 'updatedAt',
                             'updatedBy']))
            // (d) uncompletes: completion cleared, and the `uncompleted`
            //     event (B-05, its own id) is created in the same batch.
            || (prev().get('status', '') == 'completed'
              && next().get('status', '') in ['scheduled', 'in_progress']
              && next().get('completedAt', null) == null
              && next().get('completedBy', null) == null
              && occurrenceChanged()
                   .hasOnly(['subtaskDone', 'status', 'completedAt',
                             'completedBy', 'lastEventId', 'updatedAt',
                             'updatedBy'])
              && occurrenceChanged().hasAny(['lastEventId'])
              && occurrenceEventNew(f, o, 'uncompleted', 0))
          );

        // 3. VERIFY (M-05; old rule 2 was merged into rule 1, M-02): a MANAGER who is not the person who completed it,
        //    only a task that requires it (snapshot) while the family switch
        //    is on, and only with the `verified` event in the same batch.
        //    Matches `PermissionPolicy.verifyChore` and the use case.
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') == 'completed'
          && prev().get('completedBy', '') != request.auth.uid
          && prev().get('verification', 'off') == 'required'
          && (exists(permissionsPath(f))
              && get(permissionsPath(f)).data
                   .get('choreVerificationEnabled', false) == true)
          && next().get('status', '') == 'verified'
          && next().get('verifiedAt', null) is timestamp
          && next().get('verifiedBy', '') == request.auth.uid
          && occurrenceChanged()
               .hasOnly(['status', 'verifiedAt', 'verifiedBy', 'lastEventId',
                         'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'verified', 0);

        // 4. REOPEN: a completed task by anyone who may comment on it, a
        //    VERIFIED one by a manager only (verified_requires_manager).  The
        //    reason and the cleared completion survive on the `reopened` event.
        //    B-04: a task with steps is only "in progress" again when the steps
        //    to redo are UNTICKED, so the patch may shrink `subtaskDone` (it can
        //    never grow or rewrite a tick here).
        allow update: if verified()
          && isActiveMember(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && (
            (prev().get('status', '') == 'completed')
            || (prev().get('status', '') == 'verified' && isManager(f))
          )
          && next().get('status', '') == 'in_progress'
          && next().get('reopenCount', 0) == prev().get('reopenCount', 0) + 1
          && next().get('completedAt', null) == null
          && next().get('completedBy', null) == null
          && next().get('verifiedAt', null) == null
          && next().get('verifiedBy', null) == null
          && next().get('subtaskDone', {}).size()
               <= prev().get('subtaskDone', {}).size()
          && occurrenceChanged()
               .hasOnly(['status', 'reopenCount', 'completedAt', 'completedBy',
                         'verifiedAt', 'verifiedBy', 'subtaskDone',
                         'lastEventId', 'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'reopened', 3)
          && getAfter(occurrenceEventPath(f, o, next().lastEventId)).data
               .get('prevCompletedAt', null) == prev().get('completedAt', null);

        // 5. EXCEPTION (manager): finish without the required steps.
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && (!('exception' in prev().keys()) || prev().exception == null)
          && next().get('exception', null) is map
          && next().get('exception', {}).get('by', '') == request.auth.uid
          && next().get('status', '') == prev().get('status', '')
          && occurrenceChanged()
               .hasOnly(['exception', 'lastEventId', 'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'exception', 3);

        // 6. SKIP / UNSKIP (manager).
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') in ['scheduled', 'in_progress']
          && next().get('status', '') == 'skipped'
          && next().get('skipReason', null) in ['absence', 'manager']
          && occurrenceChanged()
               .hasOnly(['status', 'skipReason', 'lastEventId',
                         'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'skipped', 3);
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') == 'skipped'
          && next().get('status', '') == 'scheduled'
          && next().get('skipReason', null) == null
          && occurrenceChanged()
               .hasOnly(['status', 'skipReason', 'lastEventId',
                         'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'unskipped', 0);

        // 7. REASSIGN (manager) or a manual ASSIGN.  The assignee only moves
        //    together with a `reassigned` event that carries the reason.
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') in ['scheduled', 'in_progress']
          && next().get('status', '') == prev().get('status', '')
          && next().get('assigneeId', null) != prev().get('assigneeId', null)
          && next().get('assignmentSource', '') in ['manual', 'reassign']
          && occurrenceChanged()
               .hasOnly(['assigneeId', 'plannedAssigneeId', 'assignmentSource',
                         'needsCover', 'lastEventId', 'updatedAt', 'updatedBy'])
          && occurrenceEventNew(f, o, 'reassigned', 3);

        // 8. SWAP / COVER: the assignee moves only with a `swapped`/`covered`
        //    event that names the accepted request (P3-26 supplies its rules).
        allow update: if verified()
          && isActiveMember(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') in ['scheduled', 'in_progress']
          && next().get('status', '') == prev().get('status', '')
          && next().get('assigneeId', null) != prev().get('assigneeId', null)
          && next().get('assignmentSource', '') in ['swap', 'cover']
          && occurrenceChanged()
               .hasOnly(['assigneeId', 'coverForId', 'assignmentSource',
                         'needsCover', 'lastEventId', 'updatedAt', 'updatedBy'])
          && occurrenceChanged().hasAny(['assigneeId'])
          && (
            (next().get('assignmentSource', '') == 'swap'
              && occurrenceEventNew(f, o, 'swapped', 3))
            || (next().get('assignmentSource', '') == 'cover'
              && occurrenceEventNew(f, o, 'covered', 3))
          );

        // 9. ATTENTION flag and the comment marker (P3-25).
        allow update: if verified()
          && isActiveMember(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && occurrenceChanged()
               .hasOnly(['needsAttention', 'lastCommentAt',
                         'updatedAt', 'updatedBy'])
          && (next().get('needsAttention', false) == false
              ? mayTick(f, prev())
              : true);

        // 10. REPLAN (manager): only an unstarted document, only its snapshot.
        allow update: if verified()
          && isManager(f)
          && prev().get('deletedAt', null) == null
          && occurrenceOk(o, next())
          && prev().get('status', '') == 'scheduled'
          && prev().get('subtaskDone', {}).size() == 0
          && prev().get('completedAt', null) == null
          && prev().get('reopenCount', 0) == 0
          && occurrenceChanged()
               .hasOnly(['templateRev', 'nameBn', 'nameEn', 'groupId',
                         'instructions', 'subtasks', 'requiredCount',
                         'difficulty',
                         'estimatedMinutes', 'verification', 'dueAt',
                         'dueMinutes', 'plannedAssigneeId', 'assigneeId',
                         'assignmentSource', 'needsCover',
                         'updatedAt', 'updatedBy']);

        // 11. SOFT DELETE (M-04): a manager, only an unstarted FUTURE document:
        //     scheduled, no ticks, never completed, never reopened.
        allow update: if verified()
          && isManager(f)
          && occurrenceOk(o, next())
          && prev().get('deletedAt', null) == null
          && next().get('deletedAt', null) is timestamp
          && next().get('deletedBy', '') == request.auth.uid
          && prev().get('status', '') == 'scheduled'
          && prev().get('subtaskDone', {}).size() == 0
          && prev().get('completedAt', null) == null
          && prev().get('reopenCount', 0) == 0
          && (next().get('dateKey', '') > todayKey(f))
          && occurrenceChanged()
               .hasOnly(['deletedAt', 'deletedBy', 'updatedAt', 'updatedBy']);

        // 12. RESTORE (B-06, manager): a resumed template or a re-added date
        //     brings back a soft-deleted, still unstarted document.  Only the
        //     snapshot fields (the replan set) and the delete pair change;
        //     every update rule above requires a live document, so without
        //     this rule `RegenerateRange` could never restore anything.
        allow update: if verified()
          && isManager(f)
          && occurrenceOk(o, next())
          && prev().get('deletedAt', null) != null
          && next().get('deletedAt', null) == null
          && next().get('deletedBy', null) == null
          && prev().get('status', '') == 'scheduled'
          && prev().get('subtaskDone', {}).size() == 0
          && occurrenceChanged()
               .hasOnly(['templateRev', 'nameBn', 'nameEn', 'groupId',
                         'instructions', 'subtasks', 'requiredCount',
                         'difficulty',
                         'estimatedMinutes', 'verification', 'dueAt',
                         'dueMinutes', 'plannedAssigneeId', 'assigneeId',
                         'assignmentSource', 'needsCover',
                         'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy']);

        allow delete: if false;

        // Append-only lifecycle history: create-only, by its own actor, the
        // closed type list, and a reason where one is required.  A later
        // correction is a NEW event, never an edit (P3-11).
        match /events/{e} {
          allow read: if isActiveMember(f);
          allow create: if verified()
            && isActiveMember(f)
            && createsAsSelf()
            && occurrenceEventOk(request.resource.data)
            && request.resource.data.actorId == request.auth.uid
            && (!(request.resource.data.type in ['reopened', 'exception',
                                                 'skipped', 'reassigned'])
                || str(request.resource.data.get('reason', ''), 3, 300));
          allow update, delete: if false;
        }
      }

      // ── budgets/{yyyy-MM} — finance managers write, members read (P2-17) ─
      // A budget is a plan, so it is not tied to the month lock.  A moderator
      // needs `moderatorManagesFinance` (financeManager).  No hard delete.
      match /budgets/{b} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && financeManager(f)
          && createsAsSelf()
          && budgetOk(request.resource.data, b);
        allow update: if verified()
          && financeManager(f)
          && writesAsSelf()
          && budgetOk(request.resource.data, b);
        allow delete: if false;
      }

      // ── contributionPlans/{yyyy-MM_memberId} (P2-19) ─────────────────────
      // Every active member reads every plan (D-P2-5).  A plan is a plan, not
      // a ledger row, so a closed month does not block it (like budgets).
      match /contributionPlans/{p} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && financeManager(f)
          && createsAsSelf()
          && contributionPlanOk(request.resource.data, p);
        allow update: if verified()
          && financeManager(f)
          && writesAsSelf()
          && contributionPlanOk(request.resource.data, p)
          && request.resource.data.get('memberId', '')
               == resource.data.get('memberId', '')
          && request.resource.data.get('monthKey', '')
               == resource.data.get('monthKey', '');
        allow delete: if false;
      }

      // ── contributions/{c} — requests, records and decisions (P2-19) ─────
      // Every active member reads every contribution (D-P2-5).  A member can
      // only REQUEST (pending, no ledger row); the Household Manager or Admin
      // records, approves, rejects and voids.  Every write needs an open month.
      match /contributions/{c} {
        allow read: if canReadFamilyData(f);
        allow create: if verified()
          && createsAsSelf()
          && contributionCreateOk(f, c, request.resource.data);
        allow update: if verified()
          && writesAsSelf()
          && contributionUpdateOk(f, c);
        allow delete: if false;
      }

      // ── Append-only logs ───────────────────────────────────────────────
      match /activity/{a} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && (isActiveMember(f) || creatingFamily(f) || joiningNow(f))
          && eventOk(request.resource.data);
        allow update, delete: if false;
      }
      match /auditLogs/{a} {
        allow read: if isAdmin(f);
        allow create: if verified()
          && (isActiveMember(f) || creatingFamily(f) || joiningNow(f))
          && eventOk(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // Financial and chore data: never hard-deleted (CLAUDE.md rule 5, soft
    // delete only).  The collections arrive in Steps 12-31; this deny-only
    // rule is in place first so that a forgotten collection can only ever
    // under-grant.  Each of those steps must still add its own read/write and
    // field-validation rules here.
    //   memberAvailability, swapRequests, notificationInbox, memberStats
    // (choreOccurrences was carved out above in P3-13.)
    // ══════════════════════════════════════════════════════════════════════
    match /families/{f}/{collection}/{doc} {
      allow read, write: if false;
      allow delete: if false;
    }

    // Default deny for everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
