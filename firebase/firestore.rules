rules_version = '2';

// ============================================================================
// Family Hub — Firestore Security Rules v2.0 (Step 10 + hardening H4 + H5)
//
// One permission matrix, twice: `lib/core/permissions/permission_policy.dart`
// for the app, and this file for the backend.  CLAUDE.md hard rule 12: every
// permission is enforced here as well as in the UI.
//
// Collections covered today (roadmap Steps 6-9, hardening H4/H5):
//   users/{uid}
//   inviteCodes/{code}
//   families/{f}
//   families/{f}/members/{m}
//   families/{f}/invitations/{i}
//   families/{f}/settings/{s}
//   families/{f}/activity/{a}
//   families/{f}/auditLogs/{a}
//
// Everything else is denied (default deny at the bottom).  From Step 10 onward
// CLAUDE.md requires every step that adds a collection to extend this file AND
// `firebase/rules_test/` in the same commit.
//
// H5 additions:
//   * field validation helpers (`str`, `optStr`, `memberProfileOk`) on every
//     member write and on `users/{uid}.fullName`/`nickname`;
//   * closed key sets (`keys().hasOnly(...)`) for members, families, invites,
//     settings and logs — the lists live in ONE place here as `*Keys()`
//     functions and are mirrored by `test/contract/rules_key_sets_test.dart`;
//   * log integrity: an activity/audit `create` must be written by its own
//     actor, with a known `type`/`refType`, bounded `refId`, a small `params`
//     map and a SERVER `recordedAt` (the client `createdAt` is untouched);
//   * an invite may only be burned in the SAME batch that creates the caller's
//     pending member document;
//   * `verified()`: a verified email is required for every mutating action
//     except the owner's own `users/{uid}` profile/preferences.
//
// H6 additions (decision D4: at most three admins):
//   * `families/{f}.adminIds` lists 1..3 uids of ACTIVE admins.  A family
//     create writes the creator alone; a family update re-checks every listed
//     uid against its member document (`adminIdsOk`), so the list can never
//     name a non-admin, an inactive member or an empty set;
//   * a member update that changes the active-admin set (demote, disable,
//     remove, leave or promote) MUST rewrite the family document in the SAME
//     batch (`adminIdsRewritten`), so the check above always runs and the last
//     admin cannot leave, be demoted or be disabled — the invariant the rules
//     could not express before.  `leavesNoActiveAdmin` in permission_access.dart
//     stays as the client-side guard with a localized message; the rules are
//     the real enforcement.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Primitives ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // H5: an address-verified account is required for every mutating action
    // outside the owner's own profile.  The claim is refreshed by
    // FirebaseAuthRepository.reloadUser() (`getIdToken(true)`).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function writesAsSelf() {
      return request.resource.data.get('updatedBy', '') == request.auth.uid;
    }
    function createsAsSelf() {
      return request.resource.data.get('createdBy', '') == request.auth.uid;
    }
    function inList(value, allowed) {
      return value in allowed;
    }
    // H5 field validation.
    function str(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }
    function optStr(d, k, hi) {
      return !(k in d.keys()) || d[k] == null || str(d[k], 0, hi);
    }
    // Enums are validated against the closed sets of the domain models, so a
    // forged document fails here rather than at the next read.
    function relationshipOk(data) {
      return data.get('relationship', 'other') in
        ['father', 'mother', 'son', 'daughter', 'husband', 'wife', 'housewife',
         'daughterInLaw', 'sonInLaw', 'other'];
    }
    function genderOk(data) {
      return !('gender' in data.keys())
        || data.gender == null
        || data.gender in ['male', 'female', 'other'];
    }
    // users/{uid}.preferences {themeId, themeMode, language, banglaDigits}.
    function preferencesOk(data) {
      return !('preferences' in data.keys())
        || (
          data.preferences is map
          && data.preferences.get('themeId', '') is string
          && data.preferences.get('themeMode', 'system') in ['system', 'light', 'dark']
          && data.preferences.get('language', 'bn') in ['bn', 'en']
          && data.preferences.get('banglaDigits', false) is bool
        );
    }
    // Money is integer paisa (CLAUDE.md rule 1).  Applied to the money
    // collections from Step 13 (`expenses`) onwards; no money field exists yet,
    // so this helper is the guard those steps must use rather than a new one.
    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }
    function isNonNegativeIntOrMissing(data, key) {
      return !(key in data.keys()) || isNonNegativeInt(data[key]);
    }
    // H5: the denormalised member profile.  Applied to every member create and
    // to the admin/self updates (the field set is the same).
    function memberProfileOk(d) {
      return str(d.get('fullName', ''), 1, 80)
        && optStr(d, 'nickname', 40)
        && relationshipOk(d)
        && optStr(d, 'spouseId', 40)
        && optStr(d, 'avatarKey', 40)
        && optStr(d, 'inviteCode', 16);
    }

    // ── Closed key sets (H5) ───────────────────────────────────────────────
    // The exact fields each mapper writes.  A document with an unknown field is
    // denied.  Mirrored in test/contract/rules_key_sets_test.dart so a mapper
    // change that is not reflected here fails the build.
    function memberKeys() {
      return ['uid', 'role', 'status', 'fullName', 'nickname', 'relationship',
              'spouseId', 'avatarKey', 'inviteCode', 'removedAt', 'leftAt',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function familyKeys() {
      return ['name', 'adminIds', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy', 'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    // inviteCodes/{code} and families/{f}/invitations/{i} share one shape.
    function invitationKeys() {
      return ['code', 'familyId', 'role', 'status', 'expiresAt', 'usedBy',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion'];
    }
    // The union of the four settings documents created with the family.
    function settingsKeys() {
      return ['timezone', 'currency', 'flags', 'absencePolicy', 'enabled',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion', 'deletedAt', 'deletedBy'];
    }
    function eventKeys() {
      return ['type', 'actorId', 'summary', 'refType', 'refId', 'params',
              'recordedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
              'schemaVersion'];
    }
    function settingsOk(d) {
      return d.keys().hasOnly(settingsKeys())
        && optStr(d, 'timezone', 64)
        && optStr(d, 'currency', 8)
        && (!('flags' in d.keys())
            || (d.flags is map && d.flags.size() <= 8))
        && optStr(d, 'absencePolicy', 32);
    }

    // ── Log integrity (H5) ─────────────────────────────────────────────────
    // The closed `type` list, mirrored by lib/core/audit/audit_event_type.dart
    // (compared to this literal by test/core/audit/audit_event_type_test.dart).
    function eventTypes() {
      return ['family.created', 'member.requested', 'member.approved',
              'member.rejected', 'member.disabled', 'member.role_changed',
              'member.admin_transferred', 'member.left', 'member.cancelled',
              'invitation.created', 'invitation.revoked', 'family.updated'];
    }
    function refTypes() {
      return ['family', 'member', 'invitation'];
    }
    function paramsOk(d) {
      return !('params' in d.keys())
        || (d.params is map && d.params.size() <= 8);
    }
    // An append-only log entry: written by its own actor, with a known shape and
    // a SERVER timestamp.  `createdAt` is the device clock and is deliberately
    // NOT compared with request.time (a queued offline write would be refused).
    function eventOk(d) {
      return createsAsSelf()
        && d.get('actorId', '') == request.auth.uid
        && d.get('type', '') in eventTypes()
        && d.get('refType', '') in refTypes()
        && str(d.get('refId', ''), 0, 64)
        && optStr(d, 'summary', 200)
        && paramsOk(d)
        && d.get('recordedAt', null) == request.time
        && d.keys().hasOnly(eventKeys());
    }

    // ── Family membership helpers (roadmap Section 13 names) ───────────────
    function familyPath(f) {
      return /databases/$(database)/documents/families/$(f);
    }
    function memberPath(f, uid) {
      return /databases/$(database)/documents/families/$(f)/members/$(uid);
    }
    // The caller's member document, or an empty map when there is none.
    //
    // The empty-map fallback matters: in rules an *error* in an operand makes
    // the whole condition an error, and `get(...).data` on a missing document
    // is exactly such an error.  With `{}` every helper below is a clean false
    // instead, so a denial is reported for the right reason.
    function me(f) {
      return exists(memberPath(f, request.auth.uid))
        ? get(memberPath(f, request.auth.uid)).data
        : {};
    }
    function isMember(f) {
      return signedIn() && exists(memberPath(f, request.auth.uid));
    }
    function role(f) {
      return me(f).get('role', '');
    }
    // Active = approved, and not rejected (soft delete) or disabled.
    function isActiveMember(f) {
      return signedIn()
        && me(f).get('status', 'pending') == 'active'
        && me(f).get('removedAt', null) == null;
    }
    function isAdmin(f) {
      return isActiveMember(f) && role(f) == 'admin';
    }
    function isMod(f) {
      return isActiveMember(f) && role(f) == 'moderator';
    }
    // Admin or moderator: may invite and decide requests (Step 9 rule).
    function isManager(f) {
      return isAdmin(f) || isMod(f);
    }

    // ── Active-admin set (H6) ──────────────────────────────────────────────
    // `families/{f}.adminIds` is the denormalised list of ACTIVE admins.  The
    // rules re-check it against the member documents, so a forged list is
    // rejected and the family can never be left without an admin.
    function isActiveAdminData(d) {
      return d.get('role', '') == 'admin'
        && d.get('status', '') == 'active'
        && d.get('removedAt', null) == null
        && d.get('leftAt', null) == null;
    }
    // Index [i] of `ids` names an active admin after the batch.  The size guard
    // keeps the list index in range (evaluated first, `||` short-circuits).
    function adminAfterOk(f, ids, i) {
      return i >= ids.size()
        || isActiveAdminData(getAfter(memberPath(f, ids[i])).data);
    }
    // The family document after a write: 1..3 uids, each an active admin.
    function adminIdsOk(f) {
      let ids = request.resource.data.get('adminIds', []);
      return ids.size() >= 1
        && ids.size() <= 3
        && adminAfterOk(f, ids, 0)
        && adminAfterOk(f, ids, 1)
        && adminAfterOk(f, ids, 2);
    }
    // A newly created family has exactly its creator as its only admin.
    function creatorIsAdmin() {
      let ids = request.resource.data.get('adminIds', []);
      return ids.size() == 1 && ids[0] == request.auth.uid;
    }
    // Did this member write change whether the member is an active admin?
    function adminSetChanges() {
      return isActiveAdminData(resource.data)
        != isActiveAdminData(request.resource.data);
    }
    // The family document must be part of THIS batch and its `adminIds` must
    // change (a no-op family write does not satisfy the requirement).
    function adminIdsRewritten(f) {
      return getAfter(familyPath(f)).data.diff(get(familyPath(f)).data)
        .affectedKeys().hasAny(['adminIds']);
    }

    // ── Enrollment helpers ────────────────────────────────────────────────
    // True only inside the ONE batch that creates a family: the family document
    // does not exist yet and the caller is its creator.
    function creatingFamily(f) {
      return verified()
        && !exists(/databases/$(database)/documents/families/$(f))
        && getAfter(/databases/$(database)/documents/families/$(f)).data.createdBy
             == request.auth.uid;
    }
    function codeDoc(code) {
      return exists(/databases/$(database)/documents/inviteCodes/$(code))
        ? get(/databases/$(database)/documents/inviteCodes/$(code)).data
        : {};
    }
    function liveCode(code) {
      return codeDoc(code).get('status', '') == 'active'
        // A missing timestamp defaults to "now", which is never > now.
        && codeDoc(code).get('expiresAt', request.time) > request.time;
    }
    // A joining member document: pending, plain member, created by the joiner,
    // backed by a live code for this family.
    function validJoin(f) {
      return verified()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('role', '') == 'member'
        && request.resource.data.get('uid', '') == request.auth.uid
        && createsAsSelf()
        && memberProfileOk(request.resource.data)
        && request.resource.data.keys().hasOnly(memberKeys())
        && request.resource.data.get('inviteCode', null) is string
        && liveCode(request.resource.data.inviteCode)
        && codeDoc(request.resource.data.inviteCode).get('familyId', '') == f;
    }
    // A self-write may never change who it is...
    function identityStable() {
      return request.resource.data.uid == resource.data.uid;
    }
    // ...nor promote itself...
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }
    // ...nor approve itself.
    function statusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }
    // What a decision on a pending request may produce: approve, reject
    // (back to pending, with removedAt) or decline a pending request.
    function validDecision() {
      return (request.resource.data.status == 'active'
              && request.resource.data.get('removedAt', null) == null)
        || request.resource.data.status == 'disabled'
        || (request.resource.data.status == 'pending'
            && request.resource.data.get('removedAt', null) != null);
    }
    // True inside the ONE batch that creates the caller's pending member
    // document.  The activity and audit entries of that batch are written by
    // the same user, so they use this instead of `validJoin` (their own
    // document has no `status` or `role` field to inspect).
    function joiningNow(f) {
      return verified()
        && existsAfter(memberPath(f, request.auth.uid))
        && getAfter(memberPath(f, request.auth.uid)).data.get('status', '') == 'pending'
        && getAfter(memberPath(f, request.auth.uid)).data.get('role', '') == 'member';
    }
    // The member document the caller is creating in THIS batch is a pending
    // plain member backed by [code] (H5).  Used to require that burning an
    // invite and joining happen atomically.
    function pendingJoinAfter(f, code) {
      return existsAfter(memberPath(f, request.auth.uid))
        && getAfter(memberPath(f, request.auth.uid)).data.get('status', '') == 'pending'
        && getAfter(memberPath(f, request.auth.uid)).data.get('inviteCode', null) == code;
    }
    function memberDocIsValid() {
      return inList(request.resource.data.get('role', 'member'),
                    ['admin', 'moderator', 'member'])
        && inList(request.resource.data.get('status', 'pending'),
                  ['pending', 'active', 'disabled'])
        && request.resource.data.get('uid', '') is string
        && memberProfileOk(request.resource.data)
        && request.resource.data.keys().hasOnly(memberKeys());
    }

    // ══════════════════════════════════════════════════════════════════════
    // users/{uid} — the owner only.  Holds the profile, `familyId` and
    // `preferences {themeId, themeMode, language, banglaDigits}`.
    //
    // The owner may write this WITHOUT a verified email (the verification
    // screen and the preference sync run before verification).
    // ══════════════════════════════════════════════════════════════════════
    match /users/{uid} {
      // The document may exist before the profile does (preference sync merges
      // `preferences` into it), so every profile field is optional — but the
      // ones that are present must be well formed, and the owner may never
      // claim to be somebody else.
      function userDocOk() {
        return request.resource.data.get('uid', uid) == uid
          && (!('familyId' in request.resource.data.keys())
              || request.resource.data.get('familyId', null) is string)
          && request.resource.data.get('updatedBy', uid) == uid
          && optStr(request.resource.data, 'fullName', 80)
          && optStr(request.resource.data, 'nickname', 40)
          && preferencesOk(request.resource.data)
          && relationshipOk(request.resource.data)
          && genderOk(request.resource.data);
      }

      // One family per user (CLAUDE.md rule 17): `familyId` may be set when
      // absent, kept as it is, or moved once the OLD membership is gone (the
      // member document is missing, rejected, cancelled or left).  Pending,
      // active and admin-disabled members cannot be pointed elsewhere.
      function familyPointerChangeOk() {
        let before = resource.data.get('familyId', null);
        let after = request.resource.data.get('familyId', null);
        return before == null
          || before == after
          || !exists(memberPath(before, uid))
          || get(memberPath(before, uid)).data.get('removedAt', null) != null;
      }

      allow get, list: if isSelf(uid);
      allow create: if isSelf(uid) && userDocOk();
      allow update: if isSelf(uid) && userDocOk() && familyPointerChangeOk();
      // Closing an account is not a feature: profile data is soft-deleted.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // inviteCodes/{code} — the discovery index for joining.
    //
    // Exact-id `get` only, never `list`: a signed-in, VERIFIED user with a code
    // may learn the family it belongs to, nobody may enumerate codes or
    // families.
    // ══════════════════════════════════════════════════════════════════════
    match /inviteCodes/{code} {
      allow get: if verified();
      allow list: if false;

      allow create: if verified()
        && request.resource.data.familyId is string
        && request.resource.data.familyId.size() > 0
        && isManager(request.resource.data.familyId)
        && createsAsSelf()
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'member'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(invitationKeys());

      // A joiner marks their code used IN THE SAME BATCH that creates their
      // pending member document (H5); nothing else may change, ever.
      allow update: if verified()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'usedBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(invitationKeys())
        && pendingJoinAfter(resource.data.familyId, code);

      // A manager of the code's family revokes a still-active code; nothing
      // else may change.
      allow update: if verified()
        && resource.data.status == 'active'
        && request.resource.data.status == 'revoked'
        && isManager(resource.data.familyId)
        && writesAsSelf()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(invitationKeys());

      // An expired or revoked code is a tombstone, not a deleted document.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // families/{f}
    // ══════════════════════════════════════════════════════════════════════
    match /families/{f} {
      allow create: if verified()
        && createsAsSelf()
        && str(request.resource.data.get('name', ''), 1, 80)
        && creatorIsAdmin()
        && request.resource.data.keys().hasOnly(familyKeys());

      // Active members only: a pending or rejected user reads nothing here,
      // and a member of another family reads nothing.
      allow read: if isActiveMember(f);

      // Family administration.  `editFamilySettings` is admin-only, so a
      // moderator cannot rename the family or flip a module.
      allow update: if isAdmin(f)
        && writesAsSelf()
        && str(request.resource.data.get('name', ''), 1, 80)
        && adminIdsOk(f)
        && request.resource.data.keys().hasOnly(familyKeys());

      allow delete: if false;

      // ── members/{m} ────────────────────────────────────────────────────
      match /members/{m} {
        // A member sees the family roster; everyone may read their own
        // document so the pending screen can listen to it.
        allow read: if isActiveMember(f) || isSelf(m);

        // 1. Creating the family: the first member is an active admin.
        allow create: if isSelf(m)
          && verified()
          && creatingFamily(f)
          && createsAsSelf()
          && request.resource.data.get('role', '') == 'admin'
          && request.resource.data.get('status', '') == 'active'
          && memberProfileOk(request.resource.data)
          && request.resource.data.keys().hasOnly(memberKeys());

        // 2. Joining with a live code: pending, plain member.
        allow create: if isSelf(m) && validJoin(f);

        // 3. Admin: any change (role, status, removal) — the last-admin guard
        //    lives in the domain, see the header.  A REMOVED member (rejected,
        //    cancelled or left) can never be revived by a write: they may belong
        //    to another family by now (rule 17); they must join again (rule 5).
        allow update: if isAdmin(f)
          && verified()
          && resource.data.get('removedAt', null) == null
          && resource.data.get('leftAt', null) == null
          && writesAsSelf()
          && memberDocIsValid()
          && request.resource.data.get('uid', '') == m
          // H6: a change to the active-admin set must rewrite the family doc.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 4. Moderator: decide a PENDING request only — approve, reject or
        //    decline.  Never a role, never an active member (roadmap Step 10,
        //    "moderator approve-only").
        allow update: if isMod(f)
          && verified()
          && writesAsSelf()
          && resource.data.get('status', 'pending') == 'pending'
          && resource.data.get('removedAt', null) == null
          && resource.data.get('leftAt', null) == null
          && identityStable()
          && roleUnchanged()
          && validDecision()
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'removedAt', 'updatedAt', 'updatedBy'])
          // H6: approving a pending admin still changes the active-admin set.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 5. A rejected person may ask again with a fresh code.
        allow update: if isSelf(m)
          && resource.data.get('removedAt', null) != null
          && validJoin(f);

        // 6. A member edits their own profile fields — never role or status,
        //    and never anyone else's document.
        allow update: if isSelf(m)
          && verified()
          && isActiveMember(f)
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && statusUnchanged()
          && memberProfileOk(request.resource.data)
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['fullName', 'nickname', 'relationship', 'spouseId',
                         'avatarKey', 'inviteCode', 'updatedAt', 'updatedBy']);

        // 7. LEAVE: an active member leaves on their own.  The document is kept
        //    (history): status becomes `disabled` and `leftAt` / `removedAt`
        //    carry the same timestamp.  Role never changes.
        allow update: if isSelf(m)
          && verified()
          && isActiveMember(f)
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && request.resource.data.status == 'disabled'
          && request.resource.data.get('leftAt', null) is timestamp
          && request.resource.data.get('removedAt', null)
               == request.resource.data.get('leftAt', null)
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'leftAt', 'removedAt', 'updatedAt',
                         'updatedBy'])
          // H6: an admin leaving changes the active-admin set.
          && (!adminSetChanges() || adminIdsRewritten(f));

        // 8. CANCEL: a pending person withdraws their own request.  Only
        //    `removedAt` (the same soft delete a rejection uses) changes.
        allow update: if isSelf(m)
          && verified()
          && resource.data.get('status', '') == 'pending'
          && resource.data.get('removedAt', null) == null
          && writesAsSelf()
          && identityStable()
          && roleUnchanged()
          && statusUnchanged()
          && request.resource.data.get('removedAt', null) is timestamp
          && request.resource.data.keys().hasOnly(memberKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['removedAt', 'updatedAt', 'updatedBy']);

        // Leaving and removal are soft (removedAt / status), never hard.
        allow delete: if false;
      }

      // ── invitations/{i} — the family-side mirror of inviteCodes ────────
      match /invitations/{i} {
        allow read: if isManager(f);
        allow create: if verified()
          && (isManager(f) || creatingFamily(f))
          && createsAsSelf()
          && request.resource.data.familyId == f
          && request.resource.data.keys().hasOnly(invitationKeys());
        // A joiner marks the mirror used IN THE SAME BATCH that creates their
        // pending member document (H5); a manager revokes a still-active code.
        allow update: if verified()
          && resource.data.get('status', '') == 'active'
          && request.resource.data.get('status', '') in ['used', 'revoked']
          && request.resource.data.keys().hasOnly(invitationKeys())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'usedBy', 'updatedAt', 'updatedBy'])
          && (
            (
              request.resource.data.status == 'revoked'
              && isManager(f)
              && writesAsSelf()
            )
            || (
              request.resource.data.status == 'used'
              && request.resource.data.get('usedBy', '') == request.auth.uid
              && pendingJoinAfter(f, i)
            )
          );
        allow delete: if false;
      }

      // ── settings/{s} — general, modules, rotationPolicy, notificationDefaults
      match /settings/{s} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && (isAdmin(f) || creatingFamily(f))
          && createsAsSelf()
          && settingsOk(request.resource.data);
        allow update: if isAdmin(f)
          && verified()
          && writesAsSelf()
          && settingsOk(request.resource.data);
        allow delete: if false;
      }

      // ── Append-only logs ───────────────────────────────────────────────
      match /activity/{a} {
        allow read: if isActiveMember(f);
        allow create: if verified()
          && (isActiveMember(f) || creatingFamily(f) || joiningNow(f))
          && eventOk(request.resource.data);
        allow update, delete: if false;
      }
      match /auditLogs/{a} {
        allow read: if isAdmin(f);
        allow create: if verified()
          && (isActiveMember(f) || creatingFamily(f) || joiningNow(f))
          && eventOk(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // Financial and chore data: never hard-deleted (CLAUDE.md rule 5, soft
    // delete only).  The collections arrive in Steps 12-31; this deny-only
    // rule is in place first so that a forgotten collection can only ever
    // under-grant.  Each of those steps must still add its own read/write and
    // field-validation rules here.
    //   bazarCategories, bazarItems, expenses, bazarTrips, budgets,
    //   contributions, contributionPlans, fundTransactions, memberAdvances,
    //   settlements, choreTemplates, dutyGroups, choreOccurrences,
    //   memberAvailability, swapRequests, notificationInbox, memberStats
    // ══════════════════════════════════════════════════════════════════════
    match /families/{f}/{collection}/{doc} {
      allow read, write: if false;
      allow delete: if false;
    }

    // Default deny for everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
