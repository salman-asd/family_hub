{
  "name": "family-hub-rules-test",
  "version": "0.1.0",
  "private": true,
  "description": "Firestore Security Rules tests for Family Hub (roadmap Step 10).",
  "type": "module",
  "scripts": {
    "test": "mocha \"*.test.mjs\" --reporter spec --timeout 30000",
